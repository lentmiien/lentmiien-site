- const inlineJsonEscapeMap = { '<': '\\u003c', '>': '\\u003e', '&': '\\u0026', '\u2028': '\\u2028', '\u2029': '\\u2029' };
- const fallbackEscapeInlineScriptText = (value) => String(value == null ? '' : value).replace(/[<>&\u2028\u2029]/g, (character) => inlineJsonEscapeMap[character]);
- safeJsonText = typeof safeJsonText === 'function' ? safeJsonText : fallbackEscapeInlineScriptText;
- safeJson = typeof safeJson === 'function' ? safeJson : (value) => { const json = JSON.stringify(value); return fallbackEscapeInlineScriptText(json === undefined ? 'null' : json); };

mixin navColumn(title)
  .navbar-column
    if title
      h2= title
    block

mixin navLink(href, label, variant)
  - const linkClass = variant === 'secondary' ? 'type-2-link' : 'type-1-link';
  a(class=linkClass, href=href)&attributes(attributes)= label

doctype html
html(lang=pageLang || 'en')
  head
    if gtag
      script(async src="https://www.googletagmanager.com/gtag/js?id=G-RGSSE514L4")
      script.
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'G-RGSSE514L4', { cookie_domain: 'home.lentmiien.com', cookie_flags: 'SameSite=None;Secure' });
    title= pageTitle || "Lennart's Website"
    meta(charset='utf-8')
    meta(name='viewport', content='width=device-width, initial-scale=1')
    //- Social media meta tags - start
    meta(property='og:title', content=og_title)
    meta(property='og:type', content=og_type)
    meta(property='og:url', content=og_url)
    meta(property='og:image', content=og_image)
    meta(property='og:description', content=og_description)
    meta(property='og:site_name', content=og_site_name)
    meta(property='og:image:width', content=og_image_width)
    meta(property='og:image:height', content=og_image_height)
    meta(name='twitter:card', content=twitter_card)
    meta(name='twitter:creator', content=twitter_creator)
    meta(name='twitter:title', content=twitter_title)
    meta(name='twitter:description', content=twitter_description)
    meta(name='twitter:image', content=twitter_image)
    meta(name='twitter:image:alt', content=twitter_image_alt)
    //- Social media meta tags - end
    link(href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous")
    link(rel="stylesheet" href="https://uicdn.toast.com/editor/latest/toastui-editor.min.css")
    link(rel="stylesheet" href="https://uicdn.toast.com/editor/latest/theme/toastui-editor-dark.min.css")
    link(rel="stylesheet", href="/css/color-theme.css")
    link(rel="stylesheet", href="/css/style.css")
    link(rel="stylesheet", href="/css/nav.css")
    link(rel="stylesheet", href="/css/brand.css")
    block styles
  body(class=bodyClass)
    .nav-placeholder
    header.account-topbar
      a#goTopPageBtn.nav-action-btn(href=loggedIn ? '/mypage' : '/', aria-label=loggedIn ? 'My Account' : 'Home')
        span(aria-hidden='true') ⌂
        span= loggedIn ? 'My Account' : 'Home'
      button#actionBtn.nav-action-btn(type='button', disabled) ---
      button#tools-toggle.navbar-icon(type='button', aria-controls='navbar', aria-expanded='false', aria-haspopup='dialog')
        span(aria-hidden='true') ☰
        |  Tools
    dialog#navbar.account-tools(aria-labelledby='tools-title')
      .tools-header
        div
          h2#tools-title Tools & navigation
          p Your shortcuts and the full catalog available to your account.
        button#tools-close(type='button', aria-label='Close tools') Close
      label.tools-search-label(for='tools-search') Find a tool
      input#tools-search(type='search', placeholder='Search tools, pages and groups…', autocomplete='off')
      p#tools-search-status(role='status')
      - const catalog = typeof accountNavigation !== 'undefined' ? accountNavigation : [];
      - const groups = typeof navigationGroups !== 'undefined' ? navigationGroups : [];
      - const hasPermission = permission => Array.isArray(permissions) && permissions.includes(permission);
      if loggedIn
        section.tools-shortcuts(aria-labelledby='shortcuts-title')
          .tools-section-heading
            h3#shortcuts-title Shortcuts
            a(href='/mypage#customize-shortcuts') Customize
          .tools-icon-grid
            each item in catalog.filter(n => !n.hidden && !n.public).slice(0, 8)
              a.tool-link(href=item.href, data-tool-search=`${item.label} ${item.group}`)
                img(src=item.src, alt='', width='32', height='32', loading='lazy')
                span= item.label
      .tools-groups
        each group in groups
          - const items = catalog.filter(n => n.group === group);
          if items.length
            details.tools-group(open)
              summary= group
              each subgroup in [...new Set(items.map(n => n.subgroup))]
                details.tools-subgroup(open=items.length < 10)
                  summary= subgroup
                  .tools-icon-grid
                    each item in items.filter(n => n.subgroup === subgroup)
                      a.tool-link(href=item.href, data-tool-id=item.id, data-tool-search=`${item.label} ${group} ${subgroup}`)
                        img(src=item.src, alt='', width='32', height='32', loading='lazy')
                        span
                          span= item.label
                          if item.meta
                            small= item.meta
      if loggedIn && chatmode
        section.navbar-column
          h3 Chat history
          a(href='/chat3') New chat
          ul
            li#history_list
              button(type='button', onclick='showHModalPopup()') Show all
          h3 Select head
          ul
            li#head_list
      if loggedIn === true && hasPermission("quicknote")
        +navColumn('Quick Add')
          form#quickNoteForm
            .input-group.mb-1
              input#quickNoteInput.form-control(type='text' placeholder='Quick note...')
              .input-group-append
                button.btn.btn-primary(type='submit') Save
          form#locationForm
            .input-group.mb-1
              input#locationInput.form-control(type='text' placeholder='Location name...')
              .input-group-append
                button.btn.btn-primary(type='submit') Add location
      if loggedIn
        +navColumn('Bookmarks')
          +navLink('/bookmarks', 'Manage bookmarks')
          form.navbar-bookmark-form(method='post', action='/bookmarks/add')
            input(type='hidden', name='returnTo', value=currentPath)
            .mb-1
              input.form-control.form-control-sm(type='text', name='url', placeholder='Paste URL', required)
            .mb-1
              input.form-control.form-control-sm(type='text', name='title', placeholder='Title (optional)', maxlength='160')
            .input-group.input-group-sm
              input.form-control(type='number', name='importance', min='1', max='5', step='1', value='3')
              button.btn.btn-primary(type='submit') Save
          if bookmarks && bookmarks.length
            each bookmark in bookmarks
              - const bookmarkLabel = `[${bookmark.importance}] ${bookmark.title}`;
              +navLink(bookmark.url, bookmarkLabel, 'secondary')(target='_blank', rel='noopener noreferrer')

      +navColumn('Samples & Demos')
        if htmlPaths && htmlPaths.length
          each l in htmlPaths
            .navbar-html-entry
              +navLink(l.path, l.name, 'secondary')(target="_blank", rel="noopener noreferrer")
              - const avgDisplay = typeof l.averageRating === 'number' ? l.averageRating.toFixed(2) : null;
              - const ratingParts = Array.isArray(l.ratings) ? l.ratings.filter(r => Number.isFinite(r.score)).map(r => `${r.label}: ${r.score}`) : [];
              if avgDisplay || ratingParts.length
                small.navbar-html-rating
                  if avgDisplay
                    span.navbar-html-rating-avg Avg #{avgDisplay}
                    if l.version
                      span.navbar-html-rating-version  | v#{l.version}
                  if ratingParts.length
                    if avgDisplay
                      span.navbar-html-rating-sep  |
                    span.navbar-html-rating-breakdown= ratingParts.join(' | ')
        else
          small.navbar-html-empty No public demos yet.
    .container-fluid(class=contentContainerClass)
      block content
    unless hideLayoutFooterSpacer
      div(style="height:50px;")
    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous")
    script(src="/js/nav.js", defer)
    script(src="/js/layout.js", defer)
    if loggedIn === true
      script(src="https://cdn.socket.io/4.0.0/socket.io.min.js", defer)
      script(src="/js/notifications.js", defer)
    block script
