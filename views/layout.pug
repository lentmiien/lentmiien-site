- const inlineJsonEscapeMap = { '<': '\\u003c', '>': '\\u003e', '&': '\\u0026', '\u2028': '\\u2028', '\u2029': '\\u2029' };
- const fallbackEscapeInlineScriptText = (value) => String(value == null ? '' : value).replace(/[<>&\u2028\u2029]/g, (character) => inlineJsonEscapeMap[character]);
- safeJsonText = typeof safeJsonText === 'function' ? safeJsonText : fallbackEscapeInlineScriptText;
- safeJson = typeof safeJson === 'function' ? safeJson : (value) => { const json = JSON.stringify(value); return fallbackEscapeInlineScriptText(json === undefined ? 'null' : json); };

