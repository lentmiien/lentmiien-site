extends two_factor_layout

block content
  h1 Log in
  .settings-panel
    if loginError
      p.settings-notice.settings-error(role='alert')= loginError
    form(action='/login', method='post')
      input(type='hidden', name='_csrf', value=csrfToken)
      label(for='username') Username
      input#username(type='text', name='username', autocomplete='username', maxlength='100', required)
      label(for='password') Password
      input#password(type='password', name='password', autocomplete='current-password', maxlength='1024', required)
      button(type='submit') Log in
    p.settings-hint If needed, you will be asked to verify your account next. This browser remembers verification for 90 days, until your password changes.
