extends layout

block styles
  link(rel="stylesheet", href="/vendor/katex/katex.min.css")
  link(rel="stylesheet", href="/css/chat5_export.css")
  link(rel="stylesheet", href="/css/chat5_chat.css")

block content
  - const personaOptions = Array.isArray(personalities) ? personalities : [];
  - const responseTypeOptions = Array.isArray(responseTypes) ? responseTypes : [];
  - const availableToolOptions = typeof availableTools !== 'undefined' && Array.isArray(availableTools) ? availableTools : [];
  - const trainingGroupOptions = typeof trainingGroups !== 'undefined' && Array.isArray(trainingGroups) ? trainingGroups : [];
  - const trainingEntryOptions = typeof trainingEntries !== 'undefined' && Array.isArray(trainingEntries) ? trainingEntries : [];
  - const latestTrainingGroupId = trainingEntryOptions[0] && trainingEntryOptions[0].groupId ? trainingEntryOptions[0].groupId.toString() : '';
  - const availableTrainingGroupIds = trainingGroupOptions.map((group) => group && group.groupId ? group.groupId.toString() : '');
  - const defaultTrainingGroupId = availableTrainingGroupIds.includes(latestTrainingGroupId) ? latestTrainingGroupId : (availableTrainingGroupIds[0] || '');
  - const quickOptions = typeof quickSettingOptions !== 'undefined' && Array.isArray(quickSettingOptions) ? quickSettingOptions : [];
  - const signedInUser = typeof currentUser === 'string' ? currentUser : '';
  -
    const trainingUsageByMessage = {};
    const ensureTrainingUsage = (messageId) => {
      const id = messageId ? messageId.toString() : '';
      if (!id) return null;
      if (!trainingUsageByMessage[id]) {
        trainingUsageByMessage[id] = {
          promptCount: 0,
          outputCount: 0,
          entryIds: [],
          groupIds: [],
        };
      }
      return trainingUsageByMessage[id];
    };
    trainingEntryOptions.forEach((entry) => {
      const entryId = entry && entry._id ? entry._id.toString() : '';
      const groupId = entry && entry.groupId ? entry.groupId.toString() : '';
      const promptIds = Array.isArray(entry && entry.promptMessageIds) ? entry.promptMessageIds : [];
      promptIds.forEach((promptId) => {
        const usage = ensureTrainingUsage(promptId);
        if (!usage) return;
        usage.promptCount += 1;
        if (entryId && usage.entryIds.indexOf(entryId) < 0) usage.entryIds.push(entryId);
        if (groupId && usage.groupIds.indexOf(groupId) < 0) usage.groupIds.push(groupId);
      });
      const usage = ensureTrainingUsage(entry && entry.outputMessageId);
      if (!usage) return;
      usage.outputCount += 1;
      if (entryId && usage.entryIds.indexOf(entryId) < 0) usage.entryIds.push(entryId);
      if (groupId && usage.groupIds.indexOf(groupId) < 0) usage.groupIds.push(groupId);
    });
    const trainingUsageLabel = (usage) => {
      if (!usage) return '';
      const roles = [];
      if (usage.promptCount > 0) roles.push('prompt');
      if (usage.outputCount > 0) roles.push('output');
      const entryCount = Array.isArray(usage.entryIds) ? usage.entryIds.length : 0;
      const countText = entryCount > 1 ? ` (${entryCount} entries)` : '';
      return `In training: ${roles.join(' + ')}${countText}`;
    };
    const trainingUsageTitle = (usage) => {
      if (!usage) return '';
      const groups = Array.isArray(usage.groupIds) && usage.groupIds.length ? ` Groups: ${usage.groupIds.join(', ')}.` : '';
      return `${trainingUsageLabel(usage)}.${groups}`;
    };
  - const trainingFlash = typeof trainingStatus !== 'undefined' && trainingStatus ? trainingStatus : {};
  - const chat5MessageWindow = typeof messageWindow !== 'undefined' && messageWindow ? messageWindow : { batchSize: 25, initialLimit: 25, total: Array.isArray(messages) ? messages.length : 0, loadedStart: 0, loadedEnd: Array.isArray(messages) ? messages.length : 0, hasMoreOlder: false, source: conversationSource };
  - const selectedTools = Array.isArray(conversation.metadata && conversation.metadata.tools) ? conversation.metadata.tools : []
  - const configuredStartMessageId = conversation.metadata && conversation.metadata.startMessageId ? conversation.metadata.startMessageId.toString() : ''
  -
    const toPositiveInt = (value, fallback = 25) => {
      const parsed = Number(value);
      return Number.isFinite(parsed) && parsed > 0 ? Math.floor(parsed) : fallback;
    };
  -
    const formatTimestamp = (value) => {
      if (!value) return 'Unknown';
      const dateValue = value instanceof Date ? value : new Date(value);
      if (Number.isNaN(dateValue.getTime())) return String(value);
      try {
        return dateValue.toLocaleString('en-US', { dateStyle: 'short', timeStyle: 'short' });
      } catch (err) {
        return dateValue.toISOString();
      }
    };
  -
    const trainingText = (message) => {
      const content = message && message.content && typeof message.content === 'object' ? message.content : {};
      return typeof content.text === 'string' ? content.text.trim() : '';
    };
  -
    const trainingPreview = (message) => {
      const text = trainingText(message).replace(/\s+/g, ' ');
      if (text.length <= 220) return text;
      return `${text.slice(0, 217)}...`;
    };
  -
    const parseJsonLikeString = (value) => {
      if (typeof value !== 'string') return value;
      const trimmed = value.trim();
      if (!trimmed) return value;
      const firstChar = trimmed[0];
      if (firstChar !== '{' && firstChar !== '[') return value;
      try {
        return JSON.parse(trimmed);
      } catch (err) {
        return value;
      }
    };
  -
    const formatStructuredMessageJson = (message) => {
      if (!message || (message.contentType !== 'function_call' && message.contentType !== 'function_call_output')) {
        return '';
      }
      const content = message.content && typeof message.content === 'object' ? message.content : {};
      const payload = content.raw && typeof content.raw === 'object' ? { ...content.raw } : {};

      if (!payload.type) payload.type = message.contentType;
      if (!payload.call_id && (content.callId || content.toolCallId)) {
        payload.call_id = content.callId || content.toolCallId;
      }
      if (!payload.tool_call_id && !payload.id && content.toolCallId) {
        payload.tool_call_id = content.toolCallId;
      }
      if (!payload.name && content.toolName) {
        payload.name = content.toolName;
      }
      if (!Object.prototype.hasOwnProperty.call(payload, 'arguments') && message.contentType === 'function_call') {
        payload.arguments = content.arguments;
      }
      if (!Object.prototype.hasOwnProperty.call(payload, 'output') && message.contentType === 'function_call_output') {
        payload.output = Object.prototype.hasOwnProperty.call(content, 'output') ? content.output : content.toolOutput;
      }
      if (!Object.prototype.hasOwnProperty.call(payload, 'status') && content.status) {
        payload.status = content.status;
      }
      if (!Object.prototype.hasOwnProperty.call(payload, 'error') && content.error) {
        payload.error = content.error;
      }
      if (!Object.prototype.hasOwnProperty.call(payload, 'result') && content.result) {
        payload.result = content.result;
      }
      if (Object.prototype.hasOwnProperty.call(payload, 'arguments')) {
        payload.arguments = parseJsonLikeString(payload.arguments);
      }
      if (Object.prototype.hasOwnProperty.call(payload, 'output')) {
        payload.output = parseJsonLikeString(payload.output);
      }

      try {
        return JSON.stringify(payload, null, 2);
      } catch (err) {
        return JSON.stringify({
          type: message.contentType,
          call_id: content.callId || content.toolCallId || null,
          error: 'Unable to stringify message payload',
        }, null, 2);
      }
    };
  - const configuredMaxMessages = toPositiveInt(conversation && conversation.metadata && conversation.metadata.maxMessages, 25);
  - const visibleLimit = Math.min(25, configuredMaxMessages);
  -
    const totalNonHiddenMessages = Array.isArray(messages)
      ? messages.reduce((acc, msg) => acc + (msg && msg.hideFromBot ? 0 : 1), 0)
      : 0;
  - const olderNonHiddenTarget = Math.max(0, totalNonHiddenMessages - visibleLimit);
  - const olderChunks = [];
  - let currentChunk = null;
  - let currentChunkNonHidden = 0;
  - let processedNonHidden = 0;
  - const visibleMessages = [];
  -
    if (Array.isArray(messages)) {
      messages.forEach((msg) => {
        const isHidden = !!(msg && msg.hideFromBot);
        const isOlder = processedNonHidden < olderNonHiddenTarget;
        if (isOlder) {
          if (!currentChunk) {
            currentChunk = { messages: [], nonHiddenCount: 0 };
            currentChunkNonHidden = 0;
            olderChunks.push(currentChunk);
          }
          currentChunk.messages.push(msg);
          if (!isHidden) {
            currentChunkNonHidden += 1;
            currentChunk.nonHiddenCount = currentChunkNonHidden;
          }
        } else {
          visibleMessages.push(msg);
        }
        if (!isHidden) {
          processedNonHidden += 1;
          if (isOlder && currentChunk && currentChunkNonHidden >= 25) {
            currentChunk = null;
            currentChunkNonHidden = 0;
          }
        }
      });
    }
  - const savedChat = conversationSource === 'conversation5';
  - const canChangeMessage = savedChat && canEditChatMessages === true;
  - const detailFields = { text: 'Text', image: 'Image file', audio: 'Audio file', tts: 'TTS file', transcript: 'Transcript', revisedPrompt: 'Image prompt', imageQuality: 'Image quality', toolOutput: 'Tool output' };
  mixin chat5MessageFrame(m)
    - const id = m._id ? m._id.toString() : '';
    - const selected = !!id && id === configuredStartMessageId;
    - const sender = m.user_id || 'Unknown';
    - const bot = sender.toUpperCase() === 'BOT';
    - const content = m.content || {};
    - const copy = formatStructuredMessageJson(m) || content.text || content.transcript || content.revisedPrompt || content.toolOutput || '';
    - const fields = Object.fromEntries(Object.keys(detailFields).map(key => [key, content[key] || '']));
    .chat5-entry(data-id=id, data-time=String(m.timestamp || ''), data-fields=JSON.stringify(fields), data-category=m.category, data-tags=(m.tags || []).join(', '), data-type=m.contentType)
      if selected
        .chat5-start-divider(role='separator', aria-label='Start message') Start message
      article.chat5-message(class={'chat5-message--bot': bot, 'chat5-message--hidden': m.hideFromBot})
        header.chat5-message-heading
          if bot
            img.chat5-avatar(src='/i/avatar.jpg', alt='')
          strong.chat5-sender= sender
          span.chat5-hidden-label(hidden=!m.hideFromBot) Hidden from model
          time= formatTimestamp(m.timestamp)
          button.chat5-action.chat5-inspect(type='button', aria-label='Message details', data-bs-toggle='modal', data-bs-target='#chat5MessageDetails') Details
        .chat5-message-body
          block
        .chat5-message-actions
          button.chat5-copy-button(type='button', aria-label='Copy message text', data-copy-text=copy, hidden=!copy) Copy
          button.chat5-action(type='button', data-chat5-start-message-id=id, aria-pressed=selected ? 'true' : 'false', disabled=!canChangeMessage)= selected ? 'Selected start message' : 'Set as start message'
          .chat5-hold-tools(role='group', aria-label='Press and hold to confirm')
            span.chat5-hold-hint(aria-hidden='true') Hold
            button.chat5-action(type='button', data-chat5-hold=m.hideFromBot ? 'show' : 'hide', title='Press and hold to change model visibility', disabled=!canChangeMessage)= m.hideFromBot ? 'Show this message' : 'Hide this message'
            button.chat5-action.chat5-remove(type='button', data-chat5-hold='remove', title='Press and hold to remove from this conversation', disabled=!canChangeMessage) Remove this message
  mixin chat5RenderMessageCard(m)
    - if (!m) return;
    - const content = m.content || {};
    - const messageLabel = `id ${m._id}, type ${m.contentType}, user ${m.user_id}`;
    - const handledMessageTypes = ['text', 'image', 'audio', 'tool', 'reasoning', 'function_call', 'function_call_output'];
    +chat5MessageFrame(m)
      if m.contentType === "text"
        div.chat5-message-text(id=`${m._id}textout`)
          if typeof content.html === 'string' && content.html.trim().length > 0
            != content.html
          else
            .chat5-message-problem
              strong Empty text message received.
              .chat5-message-problem-details= `${messageLabel}. content.text is empty, null, or missing.`
      if m.contentType === "image"
        if content.image
          img.chat5-message-image(src=`/img/${content.image}`, alt=content.revisedPrompt)
          p.chat5-image-caption
            i= content.revisedPrompt
        else
          .chat5-message-problem
            strong Image message is missing a file name.
            .chat5-message-problem-details= `${messageLabel}. content.image is empty, null, or missing.`
      if m.contentType === "audio"
        - const audioFile = content.audio || content.tts;
        - const audioTranscript = content.transcript || content.text;
        if audioFile
          audio.chat5-message-audio(controls, src=`/mp3/${audioFile}`)
        if audioTranscript
          p.chat5-audio-transcript= audioTranscript
        if !audioFile && !audioTranscript
          .chat5-message-problem
            strong Empty audio message received.
            .chat5-message-problem-details= `${messageLabel}. No audio file or transcript is present.`
      if m.contentType === "tool"
        div.chat5-message-tool
          if content.toolOutput
            i= content.toolOutput
          else
            .chat5-message-problem
              strong Empty tool message received.
              .chat5-message-problem-details= `${messageLabel}. content.toolOutput is empty, null, or missing.`
      if m.contentType === "reasoning"
        div.chat5-message-reasoning
          if typeof content.html === 'string' && content.html.trim().length > 0
            i!= content.html
          else
            .chat5-message-problem
              strong Empty reasoning message received.
              .chat5-message-problem-details= `${messageLabel}. The API response did not include reasoning summary text.`
      if m.contentType === "function_call" || m.contentType === "function_call_output"
        - const structuredJson = formatStructuredMessageJson(m);
        if structuredJson
          pre.chat5-message-json
            code.language-json= structuredJson
        else
          .chat5-message-problem
            strong= `Unable to display ${m.contentType} message.`
            .chat5-message-problem-details= `${messageLabel}. No structured payload could be built from the message content.`
      if handledMessageTypes.indexOf(m.contentType) === -1
        .chat5-message-problem
          strong Unsupported message type received.
          .chat5-message-problem-details= `${messageLabel}. contentType "${m.contentType || 'missing'}" is not handled by the browser renderer.`
  mixin chat5RenderHiddenGroup(group)
    - if (!group || !group.length) return;
    - const firstHidden = group[0];
    - const lastHidden = group[group.length - 1];
    - const hiddenLabel = group.length === 1 ? '1 hidden message' : `${group.length} hidden messages`;
    - const firstTime = formatTimestamp(firstHidden && firstHidden.timestamp);
    - const lastTime = formatTimestamp(lastHidden && lastHidden.timestamp);
    - const timeRange = firstTime === lastTime ? firstTime : `${firstTime} - ${lastTime}`;
    details.chat5-hidden-group(open=group.some(m => String(m._id) === configuredStartMessageId))
      summary.chat5-hidden-summary
        span.chat5-hidden-summary-label= hiddenLabel
        span.chat5-hidden-summary-time= timeRange
      .chat5-hidden-body
        each hiddenMsg in group
          +chat5RenderMessageCard(hiddenMsg)
  mixin chat5RenderMessageList(list)
    - if (!Array.isArray(list) || !list.length) return;
    - let buffer = [];
    each msg, idx in list
      if msg && msg.hideFromBot
        - buffer.push(msg);
        - const nextMsg = list[idx + 1];
        if !(nextMsg && nextMsg.hideFromBot)
          +chat5RenderHiddenGroup(buffer)
          - buffer = [];
      else
        if buffer.length
          +chat5RenderHiddenGroup(buffer)
          - buffer = [];
        +chat5RenderMessageCard(msg)
    if buffer.length
      +chat5RenderHiddenGroup(buffer)
  mixin chat5RenderHistoryChunk(chunk)
    - if (!chunk || !Array.isArray(chunk.messages) || !chunk.messages.length) return;
    - const firstMessage = chunk.messages[0];
    - const lastMessage = chunk.messages[chunk.messages.length - 1];
    - const rangeStart = formatTimestamp(firstMessage && firstMessage.timestamp);
    - const rangeEnd = formatTimestamp(lastMessage && lastMessage.timestamp);
    - const rangeLabel = rangeStart === rangeEnd ? rangeStart : `${rangeStart} - ${rangeEnd}`;
    - const nonHiddenCount = chunk.nonHiddenCount || chunk.messages.reduce((acc, m) => acc + (m && m.hideFromBot ? 0 : 1), 0);
    details.chat5-history-chunk(open=chunk.messages.some(m => String(m._id) === configuredStartMessageId))
      summary.chat5-history-chunk-summary
        span.chat5-chunk-pill= `Show ${nonHiddenCount} older messages`
        span.chat5-chunk-range= rangeLabel
      .chat5-chunk-body
        +chat5RenderMessageList(chunk.messages)
  mixin chat5MessageLoadControls()
    - const loadedCount = Math.max(0, (chat5MessageWindow.loadedEnd || 0) - (chat5MessageWindow.loadedStart || 0));
    - const hasMoreOlder = !!chat5MessageWindow.hasMoreOlder;
    .chat5-message-load-controls(data-chat5-load-controls, class={ 'd-none': chat5MessageWindow.source !== 'conversation5' || (!hasMoreOlder && chat5MessageWindow.total <= loadedCount) })
      button.btn.btn-outline-primary.btn-sm(type="button", data-chat5-load-more, disabled=!hasMoreOlder)= `Load ${chat5MessageWindow.batchSize || 25} older`
      button.btn.btn-outline-secondary.btn-sm(type="button", data-chat5-load-all, disabled=!hasMoreOlder) Load all
      span.small.text-muted(data-chat5-load-status)= `Showing ${loadedCount} of ${chat5MessageWindow.total || loadedCount} messages`
  mixin chat5Dialog(id, title, saveId, saveLabel, disabled)
    .modal.fade.chat5-dialog(id=id, tabindex='-1', aria-labelledby=`${id}Title`, aria-hidden='true')
      .modal-dialog.modal-lg.modal-dialog-scrollable.modal-dialog-centered
        .modal-content
          .modal-header
            h2.modal-title(id=`${id}Title`)= title
            button.btn-close(type='button', data-bs-dismiss='modal', aria-label='Close')
          .modal-body
            block
          if saveId
            .modal-footer
              if saveId === 'updateSettingsButton' && conversationSource === 'unsaved'
                small#chat5NewSettingsNote.me-auto Settings apply with your first message.
              button.btn.btn-outline-secondary(type='button', data-bs-dismiss='modal') Close
              button.btn.btn-primary(type='button', id=saveId, disabled=disabled)= saveLabel

  .chat5-workspace(data-can-edit=canEditChatMessages === true ? 'true' : 'false', data-csrf=csrfToken)
    header.chat5-topline
      .chat5-header-text
        h1#conversation_title= conversationSource === 'unsaved' && conversation.title === 'NEW' ? 'New conversation' : conversation.title
        span#chat5ModelLabel= conversation.metadata.model
      .chat5-header-tools
        button.chat5-secondary(type='button', data-bs-toggle='modal', data-bs-target='#chat5Settings') Settings
        button.chat5-secondary(type='button', data-bs-toggle='modal', data-bs-target='#chat5Training') Add to training
    #chat5Thread.chat5-thread(role='region', aria-label='Conversation messages', tabindex='0')
      .chat5-thread-inner
        details#chat5QuickSettings.chat5-disclosure(open=conversationSource === 'unsaved')
          summary Quick settings
          .chat5-disclosure-body
            .chat5-quick-settings-grid
              if conversationSource === 'unsaved'
                div(data-quick-new-only)
                  label.form-label.small(for="quickCategory") Category
                  input#quickCategory.form-control.form-control-sm(type="text", value=conversation.category)
                div(data-quick-new-only)
                  label.form-label.small(for="quickTags") Tags
                  input#quickTags.form-control.form-control-sm(type="text", value=conversation.tags.join(', '), placeholder="comma, separated")
              div
                label.form-label.small(for="quickSettingsSelect") Quick setting
                select#quickSettingsSelect.form-select.form-select-sm(data-current-user=signedInUser, disabled=quickOptions.length === 0)
                  if quickOptions.length
                    option(value="") -- Select quick setting --
                    each setting in quickOptions
                      option(value=setting._id, data-overrides=JSON.stringify(setting.overrides))= setting.name
                  else
                    option(value="") No quick settings saved
            a.small(href='/chat5/quick-settings') Manage options
            small#quickSettingsStatus.d-block(aria-live='polite')
        +chat5MessageLoadControls()
        #conversationContainer.chat5-history
          each chunk in olderChunks
            +chat5RenderHistoryChunk(chunk)
          if visibleMessages.length
            +chat5RenderMessageList(visibleMessages)
          else if !olderChunks.length
            p#chat5EmptyMessages.text-muted No messages yet.
    section#chat5Composer.chat5-composer(aria-label='Message editor')
      .chat5-composer-inner
        .chat5-composer-bar
          button#chat5ComposerToggle.chat5-toggle(type='button', aria-controls='chat5ComposerBody', aria-expanded='true')
            span.chat5-chevron(aria-hidden='true')
            span#chat5ToggleLabel Minimize editor
          span#chat5CharCounter.small 0 chars
        #chat5ComposerBody
          #message.chat5-editor
          .chat5-compose-actions
            select#messageTemplateSelect.form-select.form-select-sm(aria-label='Message template')
              option(value='') Use template…
              each t in templates
                if t.Type === 'chat'
                  option(value=t._id)= t.Category + ' – ' + t.Title
            input#fileInput.visually-hidden(type='file', accept='image/*', tabindex='-1', aria-label='Append image to conversation')
            button#chat5AddImage.chat5-action(type='button', aria-label='Add image')
              span.chat5-wide-label Add
              | Image
            button.chat5-action(type='button', data-bs-toggle='modal', data-bs-target='#chat5WritingTools', aria-label='Writing tools')
              span.chat5-wide-label Writing
              | Tools
            .chat5-send-controls
              .btn-group.dropup
                button#sendAndResponse.btn.btn-primary(type='button', aria-label='Send and request a response') Send
                  span.chat5-wide-label  & Response
                button.btn.btn-primary.dropdown-toggle.dropdown-toggle-split(type='button', data-bs-toggle='dropdown', aria-expanded='false', aria-label='More send actions')
                  span.visually-hidden More send actions
                ul.dropdown-menu
                  li
                    button#chat5Append.dropdown-item(type='button') Append
                  li
                    button#localAiChatBatch.dropdown-item(type='button' disabled) Batch
                  li
                    button#chat5AppendBot.dropdown-item(type='button') Append as bot
                  li
                    button#generateTtsBtn.dropdown-item(type='button') Generate TTS audio
                  li#localAiBatchReason.small.text-muted.px-3(hidden)
          p#completionWindowNotice.chat5-notice(role='status')
          p#localAiBatchStatus.chat5-notice(role='status')
        p#chat5ActionStatus.chat5-notice(role='status')
  template#chat5MessageFrame
    +chat5MessageFrame({})
  +chat5Dialog('chat5Settings', 'Conversation settings', 'updateSettingsButton', 'Save settings', !savedChat)
    label.chat5-input-label(for="title") Title
    .input-group.chat5-input-group
      input#title.form-control(type="text", value=conversation.title)
      button.btn.btn-warning(onclick="GenerateTitle()") AI Generate
    label.chat5-input-label(for="summary") Summary
    .d-flex.flex-wrap.gap-2.align-items-start.chat5-summary-group
      textarea#summary.form-control.flex-grow-1(rows="4")= conversation.summary || ''
      button.btn.btn-warning(type="button", onclick="GenerateSummary()") AI Generate
    label.chat5-input-label(for="category") Category
    input#category.form-control(type="text", value=conversation.category)
    label.chat5-input-label(for="tags") Tags
    input#tags.form-control(type="text", value=conversation.tags.join(", "))
    label.chat5-input-label(for="context") Context
    // Template selector for context
    .d-flex.align-items-center.flex-wrap.gap-2.mb-2.chat5-template-controls
      label.form-label.mb-0.chat5-input-label(for="contextTemplateSelect") Template
      select#contextTemplateSelect.form-select.form-select-sm.chat5-template-select
        option(value="") -- Select context template --
        each t in templates
          if t.Type === 'context'
            option(value=t._id)= t.Category + ' - ' + t.Title
      button#contextTemplateSave.btn.btn-outline-primary.btn-sm(type="button" title="Save current context as template") Save as template
    textarea#context.form-control(name="context")= conversation.metadata.contextPrompt
    label.chat5-input-label(for="tools") Tools
    select#tools.form-control(name="tools", multiple)
      option(value="image_generation", selected=selectedTools.indexOf("image_generation") >= 0) Generate Images
      option(value="web_search_preview", selected=selectedTools.indexOf("web_search_preview") >= 0) Search Web
      each tool in availableToolOptions
        option(value=tool.name, title=tool.description, selected=selectedTools.indexOf(tool.name) >= 0)= tool.displayName || tool.name
    label.chat5-input-label(for="model") Model
    select#model.form-control(name="model")
      option(value=conversation.metadata.model) Use previous (#{conversation.metadata.model})
      each m in chat_models
        option(value=m.api_model)= m.model_name
    label.chat5-input-label(for="maxMessages") Max messages
    input#maxMessages.form-control(type="number", min="1", value=conversation.metadata.maxMessages)
    label.chat5-input-label(for="startMessageId") Start message ID (optional)
    input#startMessageId.form-control(type="text", maxlength="100", value=configuredStartMessageId, placeholder="Leave blank to use the full conversation", autocomplete="off", spellcheck="false")
    small.text-muted The selected message and messages after it remain eligible for context; Max messages is applied afterward. If the ID is not found, the full conversation is used.
    label.chat5-input-label(for="reasoning") Reasoning effort
    select#reasoning.form-control(name="reasoning")
      option(value=conversation.metadata.reasoning) Use previous (#{conversation.metadata.reasoning})
      option(value="none") None *GPT 5.2+
      option(value="minimal") Minimal
      option(value="low") Low
      option(value="medium") Medium
      option(value="high") High
