extends layout

block styles
  link(rel='stylesheet', href='/css/experimental-models.css')

block content
  - const wevisModel = experiments.find(model => model.renderer === 'wevis');
  - const mingModel = experiments.find(model => model.renderer === 'audio');
  main.experimental-lab(data-csrf=csrfToken)
    h1 Experimental Models
    p.lab-warning Experimental outputs require inspection. Installation is not runtime qualification. Site elapsed time includes queueing and loading; it is not a model benchmark.
    p Private admin experiments, separate from documents, history, chat and search. Only an explicit Run sends your inputs to the configured AI Gateway.
    .lab-models
      each experiment in experiments
        section.lab-card
          h2= experiment.title
          p= experiment.warning
          p= experiment.deferred
          p= experiment.capabilitySource
          button.lab-capabilities(type='button', data-model=experiment.id) Check availability (no model load)
          pre.lab-capability-result(aria-live='polite') Not checked
    section.lab-card
      h2 Private test sessions
      p Sessions belong to this admin account and browser login. Absolute expiry is 24 hours. Closing the page does not cancel generation or delete data. Clear stops new runs, cancels local queued work and waits for active requests/downloads before deleting files. Expired sessions become inaccessible immediately; cleanup retries every minute once quiescent, including after restart.
      p Limits: 2 sessions per admin, 16 overall; 8 files/results and 8 jobs per session; 32 MiB/session, 64 MiB/admin, 256 MiB/global. Pending results reserve their maximum size. One experiment is forwarded at a time, with up to 4 locally pending.
      button#lab-create(type='button') New test session
      button#lab-refresh(type='button') Refresh sessions
      p#lab-status(role='status', aria-live='polite') Loading sessions…
      #lab-sessions
    section.lab-card
      h2 Run an experiment
      label(for='lab-session') Test session
      select#lab-session
      p Images: PNG, JPEG or WebP only, up to 8 MiB, 16 million pixels, 32–16384 pixels per side and aspect ratio ≤200. Site applies EXIF orientation, converts to RGB and stores a metadata-free PNG without resizing. The normalized file must also fit 8 MiB. TIFF and BMP are not accepted by this Site adapter.
      .lab-models
        form#lab-wevis(autocomplete='off', hidden=!wevisModel, data-model=wevisModel && wevisModel.id)
          h3 WeVis visual perception
          label(for='wevis-file') Staged image
          select#wevis-file(required)
          img#wevis-preview(hidden, alt='EXIF-oriented image that will be sent to Gateway')
          label(for='wevis-task') Task
          select#wevis-task
            option(value='ocr') OCR — read text
            option(value='detection') Detection — object descriptions
            option(value='referring') Referring — one expression
            option(value='point') Point — object descriptions
            option(value='count_box') Count with boxes
            option(value='count_point') Count with points
            option(value='ocr_grounding') OCR grounding — find text
          label(for='wevis-query') Query
          textarea#wevis-query(maxlength='1024', rows='3', disabled)
          p#wevis-help OCR requires an empty query. Text remains in model generation order.
          label(for='wevis-tokens') Maximum new tokens (1–4096)
          input#wevis-tokens(type='number', min='1', max='4096', step='1', value='1024', required)
          p Actual input plus output must fit 8192 tokens; Gateway can reject this budget.
          details
            summary Site request inspector (no transport headers)
            pre#wevis-request
          button(type='submit') Run WeVis
        form#lab-ming(autocomplete='off', hidden=!mingModel, data-model=mingModel && mingModel.id)
          h3 Ming speech generation
          label(for='ming-task') Task
          select#ming-task
            option(value='VOICE_DESIGN') Voice design
            option(value='FREEFORM') Freeform instruction
            each task in ['TTS', 'MULTILINGUAL', 'BASIC', 'EMOTION', 'DIALECT']
              option(value=task, disabled)= task + ' — check availability first'
          p#ming-availability(role='status') Reference tasks need a successful availability check: Gateway ephemeral reference v1 and Site Ming credentials.
          label(for='ming-language') Language (required)
          select#ming-language(required)
            option(value='en') English (en)
            option(value='zh') Chinese (zh)
          label(for='ming-text') Speech text (up to 500 characters)
          textarea#ming-text(maxlength='500', rows='5', required)
          details#ming-tag-field
            summary Insert a speech tag at the cursor
            #ming-tags
          #ming-style-field
            label(for='ming-style') Voice style (required, up to 512 characters)
            textarea#ming-style(maxlength='512', rows='3', required)
          #ming-instruction-field(hidden)
            label(for='ming-instruction') Instruction (required, up to 512 characters)
            textarea#ming-instruction(maxlength='512', rows='3', disabled)
          fieldset#ming-reference(hidden, disabled)
            legend Private reference audio
            p Use PCM16 WAV (16-bit signed little-endian PCM), mono or stereo, 16–48 kHz, 1–30 seconds, up to 6 MiB. Export this format in an audio editor first; MP3 conversion and browser recording are not provided.
            label(for='ming-upload') Upload a reference WAV to the selected session
            input#ming-upload(type='file', accept='.wav,audio/wav')
            button#ming-upload-button(type='button') Upload reference WAV
            label(for='ming-file') Staged reference WAV
            select#ming-file(required)
            audio#ming-reference-preview(controls, preload='none', hidden)
            p#ming-reference-metadata
            label(for='ming-transcript') Reference transcript (nonblank, up to 2048 characters and 8192 UTF-8 bytes)
            textarea#ming-transcript(maxlength='2048', rows='3', required)
            label(for='ming-consent')
              input#ming-consent(type='checkbox', required)
              |  I have permission and affirmative consent to use this voice for this request.
            p A generated synthetic clip can be downloaded and manually uploaded if it meets these limits. Consent is still required. No persistent voice is registered.
          each values, control in { speed: [['慢速', 'Slow'], ['中速', 'Medium'], ['快速', 'Fast']], pitch: [['低', 'Low'], ['中', 'Medium'], ['高', 'High']], volume: [['低', 'Low'], ['中', 'Medium'], ['高', 'High']], emotion: [['高兴', 'Happy'], ['悲伤', 'Sad'], ['愤怒', 'Angry'], ['恐惧', 'Fear'], ['厌恶', 'Disgust'], ['惊讶', 'Surprise'], ['中性', 'Neutral']], dialect: [['chuanyu dialect', 'Chuanyu dialect'], ['cantonese', 'Cantonese']] }
            div(id='ming-' + control + '-field', hidden)
              label(for='ming-' + control)= control
              select(id='ming-' + control, disabled)
                option(value='') Choose a value
                each entry in values
                  option(value=entry[0])= entry[1] + ' (' + entry[0] + ')'
          p#ming-control-help
          label(for='ming-steps') Maximum decode steps (8–400)
          input#ming-steps(type='number', min='8', max='400', step='1', value='200', required)
          p Exhausting the decode budget is an error; partial audio is not returned. Output is validated PCM16 mono WAV, up to 60 seconds.
          details
            summary Site request inspector (no credentials or headers)
            pre#ming-request
          button(type='submit') Run Ming
    section.lab-card
      h2 Runtime and privacy
      p Jobs survive browser navigation. Site shows local queueing or waiting for Gateway; there are no upstream job IDs, progress or active cancellation handles. A completed response does not prove the GPU container has stopped. Timeout or Site restart can leave completion unknown; generation is never automatically replayed.
      p Gateway holds ephemeral request memory; its worker uses a private anonymous memory descriptor, with no voice registry entry or disk spool. Normal completion closes it; failure or unknown termination can leave cleanup pending. Clearing Site data does not prove immediate GPU shutdown or forensic memory erasure.
      p Ming requires MING_ADMIN_TOKEN in server configuration, sent only as X-Ming-Token on Ming routes. This page never accepts secrets. Error inspectors omit arbitrary Gateway detail text, host paths and private inputs; full raw model text is unavailable on failed WeVis runs.
  script(src='/js/experimental-models.js', defer)
