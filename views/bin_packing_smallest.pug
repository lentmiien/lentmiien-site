extends layout

block append styles
  link(rel='stylesheet', href='/css/bin-packing.css')

block content
  section.bin-pack.bin-pack--smallest
    header.bin-pack__header
      h1.bin-pack__title Smallest Box Finder
      p.bin-pack__subtitle Find the smallest saved box that holds every item. Boxes are tried by internal volume, with 3D rotation allowed.
      p.bin-pack__hint The selected algorithm may miss a possible arrangement. If no solution is found, try another algorithm.
      a(href='/binpacking') Open the original multi-container tool
    .bin-pack__grid
      .bin-pack__column.bin-pack__column--form
        article.bin-pack__panel
          form#binPackForm.bin-pack__form(novalidate, data-smallest-box, data-csrf=csrfToken)
            p.bin-pack__hint Searches use your saved available boxes. Save any changes before searching. Up to 100 item types and 200 total items.
            fieldset.bin-pack__fieldset
              legend.bin-pack__legend Items
              .bin-pack__field
                label(for='itemsFile') Upload CSV
                input#itemsFile(type='file', accept='.csv', data-file-input)
                p.bin-pack__hint Accepts columns: id,w,d,h,weight,qty with a header row.
              .bin-pack__field
                label(for='itemsTextarea') Items CSV (header row required)
                textarea#itemsTextarea.bin-pack__textarea(name='itemsCsv', rows='8', maxlength='65536', placeholder='id,w,d,h,weight,qty')
              .bin-pack__actions
                button(type='button', class='bin-pack__secondary', data-fill-sample) Load sample data
                button(type='button', class='bin-pack__secondary', data-clear-items) Clear items
              ul.bin-pack__errors(data-parse-errors, aria-live='polite')
            fieldset.bin-pack__fieldset
              legend.bin-pack__legend Algorithm
              .bin-pack__field.bin-pack__field--algorithm
                label(for='algorithm') Choose algorithm
                select#algorithm.bin-pack__select(name='algorithm')
                  each algo in algorithms
                    if algo === 'laff'
                      option(value=algo, selected) #{algo}
                    else
                      option(value=algo) #{algo}
                p.bin-pack__hint(data-bruteforce-note) Bruteforce available for fewer than 8 total items.
            button#binPackSubmit.bin-pack__submit(type='submit') Find smallest box
      .bin-pack__column
        article.bin-pack__panel
          h2.bin-pack__panel-title Your available boxes
          p.bin-pack__hint Use internal dimensions in mm and weights in kg. Maximum load is the contents weight; zero permits only weightless items. Save up to 30 boxes with unique IDs.
          form#boxCatalogForm.bin-pack__form
            div#boxCatalogRows
            .bin-pack__actions
              button.bin-pack__secondary(type='button', data-add-box, disabled) Add box
              button.bin-pack__submit(type='submit', data-save-boxes, disabled) Save boxes
            p.bin-pack__status(data-catalog-status, role='status') Loading saved boxes…
        article.bin-pack__panel.bin-pack__panel--compact
          h2.bin-pack__panel-title Item overview
          dl.bin-pack__stats
            div
              dt Unique SKUs
              dd(data-unique-count) 0
            div
              dt Total items
              dd(data-total-count) 0
            div
              dt Total weight (kg)
              dd(data-total-weight) 0
          table.bin-pack__table
            thead
              tr
                th(scope='col') ID
                th(scope='col') Size (W x D x H)
                th(scope='col') Weight
                th(scope='col') Qty
            tbody(data-item-table)
              tr.bin-pack__table-empty
                td(colspan='4') Items will appear here after parsing the CSV.
        article.bin-pack__panel
          h2.bin-pack__panel-title Packing output
          div.bin-pack__status(data-request-status, aria-live='polite')
          div.bin-pack__meta(data-meta-summary, hidden)
            dl
              div
                dt Algorithm
                dd(data-meta-algorithm)
              div
                dt Container
                dd(data-meta-container)
              div
                dt Total items
                dd(data-meta-items)
          div#binPackOutput.bin-pack__output
            p.bin-pack__placeholder No packing requests submitted yet.
    .bin-pack__viewer-overlay(data-viewer-modal aria-hidden='true')
      .bin-pack__viewer
        header.bin-pack__viewer-header
          h3.bin-pack__viewer-title Box Preview
          button(type='button' class='bin-pack__viewer-close' data-viewer-close aria-label='Close preview') x
        .bin-pack__viewer-body
          canvas#binPackViewerCanvas(data-viewer-canvas aria-label='3D box preview')
        footer.bin-pack__viewer-footer
          button(type='button' class='bin-pack__viewer-btn' data-layer-down disabled) Down
          span.bin-pack__viewer-layer(data-layer-label) Layer 0 of 0
          button(type='button' class='bin-pack__viewer-btn' data-layer-up disabled) Up

block append script
  script(type='module', src='/js/smallest-box.js')
