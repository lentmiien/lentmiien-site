extends layout

block styles
  link(rel='stylesheet', href='/css/runpodAdmin.css')

block script
  script(src='/js/runpodAdmin.js', defer)

block content
  - const formatUsd = (value, digits = 4) => Number.isFinite(value) ? `$${value.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: digits })}` : '—';
  - const formatInteger = (value) => Number.isFinite(value) ? value.toLocaleString('en-US') : '—';
  - const formatTimestamp = (value) => { const date = value ? new Date(value) : null; return date && !Number.isNaN(date.getTime()) ? date.toLocaleString('en-US', { dateStyle: 'medium', timeStyle: 'short' }) : '—'; };
  - const formatDuration = (value) => { if (!Number.isFinite(value)) return 'Not recorded'; const seconds = Math.max(0, Math.floor(value / 1000)); const days = Math.floor(seconds / 86400); const hours = Math.floor((seconds % 86400) / 3600); const minutes = Math.floor((seconds % 3600) / 60); return days ? `${days}d ${hours}h ${minutes}m` : hours ? `${hours}h ${minutes}m` : `${minutes}m`; };
  - const formatMinutes = (value) => value % 1440 === 0 ? `${value / 1440} day${value === 1440 ? '' : 's'}` : value % 60 === 0 ? `${value / 60} hour${value === 60 ? '' : 's'}` : `${value} minutes`;
  - const operationLabel = (value) => ({ start: 'Pod start', stop: 'Pod stop', extend: 'deadline extension', delete: 'Pod deletion', auto_stop: 'automatic stop' }[value] || 'Pod operation');
  - const isoTimestamp = (value) => { const date = value ? new Date(value) : null; return date && !Number.isNaN(date.getTime()) ? date.toISOString() : ''; };
  - const refreshHref = `${adminPath}?bucketSize=${encodeURIComponent(filters.bucketSize)}&lastN=${encodeURIComponent(filters.lastN)}&refresh=1`;
  - const management = podManagement || { limits: {}, templates: [], managedPods: [], archivedPods: [], unmanagedProviderPods: [], gpuOptions: [], errors: {} };
  - const ollamaTemplate = management.templates.find((entry) => entry.slug === 'ollama') || null;
  main.runpod-admin
    header.runpod-hero
      .runpod-hero__content
        p.runpod-eyebrow Infrastructure monitor
        h1 Runpod API v2
        p.runpod-hero__subtitle Catalog and billing monitoring, reusable workload templates, and guarded Pod lifecycle controls.
      .runpod-hero__actions
        span.runpod-chip REST API #{apiVersion} · public beta
        span.runpod-chip.runpod-chip--muted= apiBaseUrl
        a.runpod-button.runpod-button--secondary(href=refreshHref) Refresh from Runpod

    .runpod-scope-note(role='note')
      strong Step 2 is enabled for administrators.
      |  Pod and template mutations use Runpod REST API v2, CSRF protection, explicit capability checks, a #{formatUsd(management.limits.maxHourlyCostUsd, 2)} server cost ceiling, at most #{formatInteger(management.limits.maxActivePods)} active Pods, and mandatory auto-stop.

    if pageError
      .runpod-alert.runpod-alert--error(role='alert')= pageError

    if notice
      .runpod-alert(class=notice.type === 'error' ? 'runpod-alert--error' : 'runpod-alert--success', role=notice.type === 'error' ? 'alert' : 'status')= notice.message

    if errorSections && errorSections.length
      .runpod-alert.runpod-alert--warning(role='alert')
        strong Some Runpod sections could not be loaded.
        ul
          each failure in errorSections
            li
              span= `${failure.label}: ${failure.message}`
              if failure.status
                small= ` HTTP ${failure.status}`

    if management.errors && Object.keys(management.errors).length
      .runpod-alert.runpod-alert--warning(role='alert')
        strong Some Pod-management data could not be loaded.
        p Catalog and billing data may still be current. Refresh before making a cost-bearing decision.

    section#workload-templates.runpod-panel(aria-labelledby='runpodWorkloadTemplateHeading')
      .runpod-panel__header
        div
          p.runpod-eyebrow Reusable setup
          h2#runpodWorkloadTemplateHeading Ollama workload template
          p.runpod-panel__subtitle The container settings are stored as a private Runpod v2 template. The local database links that provider template to the bounded Ollama model-download workflow.
        if ollamaTemplate
          span.runpod-status(class=ollamaTemplate.providerPresent ? 'runpod-status--ready' : 'runpod-status--warning')= ollamaTemplate.providerPresent ? 'SYNCED' : 'RESYNC NEEDED'

      .runpod-two-column
        article.runpod-template-summary
          if ollamaTemplate
            h3= ollamaTemplate.name
            code= ollamaTemplate.providerTemplateId || 'Provider ID pending'
            dl
              div
                dt Image
                dd= ollamaTemplate.image
              div
                dt Test model
                dd= ollamaTemplate.defaultModel
              div
                dt Storage
                dd #{formatInteger(ollamaTemplate.diskGb)} GB container + #{formatInteger(ollamaTemplate.persistentDiskGb)} GB persistent
              div
                dt Public service
                dd Port #{formatInteger(ollamaTemplate.servicePort)} through Runpod HTTPS proxy
          else
            h3 No local Ollama template yet
            p Save the defaults once to create a private provider template and its local setup recipe.

        form.runpod-form(method='post', action=`${adminPath}/templates/ollama`)
          input(type='hidden', name='_csrf', value=csrfToken)
          .runpod-form-grid
            label.runpod-field
              span Provider template name
              input(type='text', name='providerTemplateName', maxlength='80', value=ollamaTemplate ? ollamaTemplate.providerTemplateName : 'lentmiien-ollama-gpu-v2', required)
            label.runpod-field
              span Container image
              input(type='text', name='image', maxlength='500', value=ollamaTemplate ? ollamaTemplate.image : 'ollama/ollama:latest', required)
            label.runpod-field
              span Default model
              input(type='text', name='defaultModel', maxlength='120', value=ollamaTemplate ? ollamaTemplate.defaultModel : 'qwen2.5:0.5b', required)
            label.runpod-field
              span Container disk (GB)
              input(type='number', name='diskGb', min='5', max='500', step='1', value=ollamaTemplate ? ollamaTemplate.diskGb : 20, required)
            label.runpod-field
              span Persistent model disk (GB)
              input(type='number', name='persistentDiskGb', min='10', max='1000', step='1', value=ollamaTemplate ? ollamaTemplate.persistentDiskGb : 10, required)
          p.runpod-form-help The default 0.5B Qwen model is about 398 MB. Models live on the persistent disk and survive stop/start cycles. Pin the image by digest for reproducible long-term use.
          button.runpod-button.runpod-button--primary(type='submit')= ollamaTemplate ? 'Update and resync template' : 'Create Ollama template'

    section#pod-creator.runpod-panel(aria-labelledby='runpodPodCreatorHeading')
      .runpod-panel__header
        div
          p.runpod-eyebrow Cost-aware deployment
          h2#runpodPodCreatorHeading Create an Ollama Pod
          p.runpod-panel__subtitle Filter systems by VRAM and cost, then choose current availability, cloud, location, storage, model, and an automatic stop time.
        span.runpod-panel__meta #{formatInteger(management.gpuOptions.length)} GPU choices

      .runpod-alert.runpod-alert--warning(role='note')
        strong Public endpoint warning.
        |  Ollama does not authenticate local API requests. Runpod's HTTPS proxy URL is public to anyone who learns it. Keep auto-stop short and stop or delete the Pod when finished.

      if ollamaTemplate && ollamaTemplate.providerPresent && management.gpuOptions.length
        .runpod-picker(data-runpod-picker)
          .runpod-picker__filters(aria-label='GPU filters')
            label.runpod-field
              span Minimum VRAM (GB)
              input(type='number', min='0', max='300', step='1', value='16', data-gpu-min-vram)
            label.runpod-field
              span Picker max price / GPU hour
              input(type='number', min='0.01', max=management.limits.maxHourlyCostUsd, step='0.01', value='1.00', data-gpu-max-price)
            label.runpod-field
              span Minimum availability
              select(data-gpu-min-availability)
                option(value='LOW') Low or better
                option(value='MEDIUM') Medium or better
                option(value='HIGH') High only
            output.runpod-picker__result(data-gpu-filter-result aria-live='polite')

          form.runpod-form(method='post', action=`${adminPath}/pods`, data-runpod-create-form)
            input(type='hidden', name='_csrf', value=csrfToken)
            .runpod-form-grid.runpod-form-grid--wide
              label.runpod-field
                span Pod name
                input(type='text', name='name', maxlength='80', value='ollama-test', pattern='[A-Za-z0-9][A-Za-z0-9 ._-]{0,79}', required)
              label.runpod-field
                span Workload template
                select(name='templateId', required)
                  each localTemplate in management.templates
                    if localTemplate.active && localTemplate.providerPresent
                      option(value=localTemplate.id, selected=localTemplate.slug === 'ollama')= `${localTemplate.name} · ${localTemplate.defaultModel}`
              label.runpod-field
                span Cloud
                select(name='cloud', data-gpu-cloud, required)
                  option(value='SECURE', selected) Secure Cloud
                  option(value='COMMUNITY') Community Cloud
              label.runpod-field.runpod-field--span-2
                span GPU system
                select(name='gpuId', data-gpu-select, required)
                  each gpu in management.gpuOptions
                    option(
                      value=gpu.id,
                      data-memory=gpu.memoryGb,
                      data-secure-price=gpu.securePrice,
                      data-community-price=gpu.communityPrice,
                      data-secure-availability=gpu.secureAvailability,
                      data-community-availability=gpu.communityAvailability,
                      data-secure-max-count=gpu.secureMaxCount,
                      data-community-max-count=gpu.communityMaxCount,
                      data-secure-datacenters=gpu.secureDataCenters.map((entry) => entry.id).join('|'),
                      data-community-datacenters=gpu.communityDataCenters.map((entry) => entry.id).join('|')
                    )= `${gpu.name} · ${formatInteger(gpu.memoryGb)} GB VRAM · Secure ${formatUsd(gpu.securePrice)}/${gpu.secureAvailability} · Community ${formatUsd(gpu.communityPrice)}/${gpu.communityAvailability}`
              label.runpod-field
                span GPU count
                input(type='number', name='gpuCount', min='1', max=management.limits.maxGpuCount, step='1', value='1', data-gpu-count, required)
              label.runpod-field
                span Preferred data center
                select(name='dataCenterId', data-gpu-datacenter)
                  option(value='') Automatic placement
                  each dataCenter in dataCenters
                    option(value=dataCenter.id, data-global-network=dataCenter.globalNetwork ? '1' : '0')= `${dataCenter.name} · ${dataCenter.region.replaceAll('_', ' ')}`
              label.runpod-field
                span Ollama model
                input(type='text', name='model', maxlength='120', value=ollamaTemplate.defaultModel, required)
              label.runpod-field
                span Container disk (GB)
                input(type='number', name='diskGb', min='5', max='500', step='1', value=ollamaTemplate.diskGb, required)
              label.runpod-field
                span Persistent model disk (GB)
                input(type='number', name='persistentDiskGb', min='10', max='1000', step='1', value=ollamaTemplate.persistentDiskGb, required)
              label.runpod-field
                span Auto-stop after (minutes)
                input(type='number', name='autoStopMinutes', min='15', max=management.limits.maxRuntimeMinutes, step='1', value=management.limits.defaultAutoStopMinutes, required)
              label.runpod-field
                span Confirmed maximum total / hour
                input(type='number', name='maxHourlyCost', min='0.01', max=management.limits.maxHourlyCostUsd, step='0.01', value='1.00', data-gpu-cost-limit, required)
              label.runpod-check
                input(type='checkbox', name='globalNetworking')
                span Enable global networking (Secure Cloud + eligible explicit data center only)
              label.runpod-check.runpod-check--warning
                input(type='checkbox', name='publicAccessAcknowledged', value='acknowledged', required)
                span I understand that the Ollama proxy URL has no application-level authentication.
            p.runpod-form-help Large models need storage beyond their published download size. Allow at least 10 GB of headroom; qwen3.8:27b is about 18 GB, so use 30 GB or more of persistent storage.
            .runpod-estimate(role='status' aria-live='polite')
              span Estimated GPU rate
              strong(data-gpu-estimate) Choose a GPU
              small Disk charges may make Runpod's final Pod rate slightly higher. Creation is cancelled and cleaned up if the returned total exceeds your confirmed maximum.
            button.runpod-button.runpod-button--primary(type='submit', data-runpod-create-button) Create Pod and set up Ollama
      else if !ollamaTemplate || !ollamaTemplate.providerPresent
        .runpod-empty
          strong Sync the Ollama workload template first
          p Pod creation stays disabled until both the local recipe and private Runpod template are present.
      else
        .runpod-empty
          strong GPU picker unavailable
          p Refresh the page after Runpod catalog availability returns.

    section#pods.runpod-panel(aria-labelledby='runpodPodsHeading')
      .runpod-panel__header
        div
          p.runpod-eyebrow Managed compute
          h2#runpodPodsHeading Running and stopped Pods
          p.runpod-panel__subtitle Live provider state is overlaid on local lifecycle and setup records. Stop releases GPU compute, but retained storage may still be billed; delete permanently removes the Pod and its attached persistent disk.
        form(method='post', action=`${adminPath}/pods/sync`)
          input(type='hidden', name='_csrf', value=csrfToken)
          button.runpod-button.runpod-button--secondary(type='submit') Sync provider state

      if management.managedPods.length
        .runpod-pod-grid
          each pod in management.managedPods
            article.runpod-pod-card
              .runpod-pod-card__header
                div
                  h3= pod.name
                  code= pod.providerPodId
                span.runpod-status(class=`runpod-status--${pod.providerStatus.toLowerCase()}`)= pod.providerStatus
              .runpod-pod-card__metrics
                div
                  span GPU
                  strong= `${pod.gpuName || pod.gpuId} × ${formatInteger(pod.gpuCount)}`
                div
                  span Hourly rate
                  strong= `${formatUsd(pod.costPerHour)} / hr`
                div
                  span Setup
                  strong= `${pod.setupStatus}${pod.setupModel ? ` · ${pod.setupModel}` : ''}`
                div
                  span Auto-stop
                  strong= pod.autoStopAt ? formatTimestamp(pod.autoStopAt) : 'Not running'
                div
                  span Running time
                  strong= pod.usage.trackingAvailable ? formatDuration(pod.usage.runningMs) : 'Not recorded'
                div
                  span Stopped time
                  strong= pod.usage.trackingAvailable ? formatDuration(pod.usage.stoppedMs) : 'Not recorded'
                div
                  span Provider-billed cost
                  strong= pod.billing.available ? formatUsd(pod.billing.totalUsd) : 'Awaiting billing sync'
                div
                  span Observed cost estimate
                  strong= pod.usage.trackingAvailable ? formatUsd(pod.usage.estimatedTotalUsd) : 'Not available'
              if pod.providerStatus === 'RUNNING' && pod.autoStopAt
                .runpod-countdown(data-runpod-countdown, data-deadline=isoTimestamp(pod.autoStopAt), role='timer', aria-label='Time until automatic Pod shutdown')
                  span Automatic stop in
                  strong(data-runpod-countdown-value)= formatDuration(Math.max(0, new Date(pod.autoStopAt).getTime() - Date.now()))
                  time(datetime=isoTimestamp(pod.autoStopAt))= `Deadline: ${formatTimestamp(pod.autoStopAt)}`
                  small(data-runpod-countdown-warning) The Pod will stop automatically when this reaches zero. Extend it before the deadline if work is still in progress.
              if pod.billing.available
                p.runpod-form-help Provider ledger: #{formatUsd(pod.billing.computeUsd)} compute + #{formatUsd(pod.billing.storageUsd)} disk. Billing can lag current usage; last synced #{formatTimestamp(pod.billing.syncedAt)}.
              if pod.setupStatus === 'ready' && pod.providerStatus === 'RUNNING' && pod.publicUrl
                .runpod-endpoint
                  span Public Ollama URL
                  a(href=pod.publicUrl, target='_blank', rel='noopener noreferrer')= pod.publicUrl
                  small The root page should say “Ollama is running.” API requests are unauthenticated.
              else if pod.setupStatus === 'failed'
                .runpod-alert.runpod-alert--error
                  strong Setup failed and an automatic stop was attempted.
                  if pod.setupErrorCode
                    small= ` ${pod.setupErrorCode}`
              if pod.lastOperationError
                .runpod-provider-error.runpod-alert.runpod-alert--error(role='status')
                  strong= `Last ${operationLabel(pod.lastOperationError.action)} failed`
                  p= pod.lastOperationError.message || 'Runpod rejected the operation.'
                  dl
                    div
                      dt App code
                      dd
                        code= pod.lastOperationError.code || 'RUNPOD_ACTION_FAILED'
                    if pod.lastOperationError.providerStatus
                      div
                        dt Provider HTTP
                        dd= pod.lastOperationError.providerStatus
                    if pod.lastOperationError.providerCode
                      div
                        dt Provider code
                        dd
                          code= pod.lastOperationError.providerCode
                    if pod.lastOperationError.providerTitle
                      div
                        dt Provider message
                        dd= pod.lastOperationError.providerTitle
                    if pod.lastOperationError.detail && pod.lastOperationError.detail !== pod.lastOperationError.providerTitle
                      div
                        dt Provider detail
                        dd= pod.lastOperationError.detail
                  if pod.lastOperationError.occurredAt
                    small= `Recorded ${formatTimestamp(pod.lastOperationError.occurredAt)}`
              .runpod-pod-card__actions
                if pod.canStart
                  - const storedStartMinutes = Number.isFinite(pod.autoStopMinutes) ? pod.autoStopMinutes : null;
                  - const preferredStartMinutes = storedStartMinutes >= 15 && storedStartMinutes <= management.limits.maxRuntimeMinutes ? storedStartMinutes : management.limits.defaultAutoStopMinutes;
                  - const startDurationOptions = Array.from(new Set([15, 30, 60, 240, 480, 1440, preferredStartMinutes])).filter((minutes) => minutes >= 15 && minutes <= management.limits.maxRuntimeMinutes).sort((left, right) => left - right);
                  form.runpod-duration-control(method='post', action=`${adminPath}/pods/${pod.id}/start`)
                    input(type='hidden', name='_csrf', value=csrfToken)
                    label.runpod-field
                      span Start for…
                      select(name='runMinutes', required)
                        each minutes in startDurationOptions
                          option(value=minutes, selected=minutes === preferredStartMinutes)= formatMinutes(minutes)
                    button.runpod-button.runpod-button--primary(type='submit') Start Pod
                if pod.canExtend
                  .runpod-extension-control
                    span.runpod-extension-control__label Extend automatic stop
                    .runpod-extension-control__quick
                      each extension in [{ minutes: 30, label: '+30m' }, { minutes: 60, label: '+1h' }, { minutes: 240, label: '+4h' }]
                        form(method='post', action=`${adminPath}/pods/${pod.id}/extend`)
                          input(type='hidden', name='_csrf', value=csrfToken)
                          input(type='hidden', name='extensionMinutes', value=extension.minutes)
                          button.runpod-button.runpod-button--secondary(type='submit')= extension.label
                    form.runpod-duration-control.runpod-duration-control--custom(method='post', action=`${adminPath}/pods/${pod.id}/extend`)
                      input(type='hidden', name='_csrf', value=csrfToken)
                      label.runpod-field
                        span Custom (minutes)
                        input(type='number', name='extensionMinutes', min='15', max=management.limits.maxRuntimeMinutes, step='1', value='60', required)
                      button.runpod-button.runpod-button--secondary(type='submit') Extend
                if pod.canStop
                  form(method='post', action=`${adminPath}/pods/${pod.id}/stop`)
                    input(type='hidden', name='_csrf', value=csrfToken)
                    button.runpod-button.runpod-button--secondary(type='submit') Stop
                if pod.setupStatus === 'failed' && pod.providerStatus === 'RUNNING'
                  form(method='post', action=`${adminPath}/pods/${pod.id}/setup`)
                    input(type='hidden', name='_csrf', value=csrfToken)
                    button.runpod-button.runpod-button--secondary(type='submit') Retry setup
              if pod.canDelete
                details.runpod-delete
                  summary Permanently delete Pod
                  form(method='post', action=`${adminPath}/pods/${pod.id}/delete`, data-runpod-delete-form)
                    input(type='hidden', name='_csrf', value=csrfToken)
                    label.runpod-field
                      span Type the exact Pod name: #{pod.name}
                      input(type='text', name='confirmation', maxlength='120', autocomplete='off', required)
                    button.runpod-button.runpod-button--danger(type='submit') Delete Pod and disk
      else
        .runpod-empty
          strong No managed Pods
          p Create a Pod above, or synchronize if Pods already exist in the Runpod account.

      if management.unmanagedProviderPods.length
        .runpod-unmanaged
          h3 Untracked provider Pods
          p These Pods exist in Runpod but do not yet have local lifecycle records. Use “Sync provider state” to import them before managing them here.
          ul
            each pod in management.unmanagedProviderPods
              li
                strong= pod.name
                span= ` ${pod.providerStatus} · ${pod.gpuId} × ${formatInteger(pod.gpuCount)} · ${formatUsd(pod.costPerHour)}/hr`

    section#archived-pods.runpod-panel(aria-labelledby='runpodArchivedPodsHeading')
      .runpod-panel__header
        div
          p.runpod-eyebrow Retained audit state
          h2#runpodArchivedPodsHeading Archived Pods
          p.runpod-panel__subtitle Terminated provider resources remain as view-only local records with observed lifecycle time and exact v2 billing where available. Older billing-only records do not claim unknown runtimes.
        span.runpod-panel__meta #{formatInteger(management.archivedPods.length)} archived
      if management.archivedPods.length
        .runpod-table-wrap
          table.runpod-table
            caption Archived Runpod Pod records
            thead
              tr
                th(scope='col') Pod
                th(scope='col') GPU
                th(scope='col') Running
                th(scope='col') Stopped
                th.runpod-number(scope='col') Provider billed
                th.runpod-number(scope='col') Observed estimate
                th(scope='col') Archived / coverage end
            tbody
              each pod in management.archivedPods
                tr
                  td.runpod-system
                    strong= pod.name
                    code= pod.providerPodId
                  td= `${pod.gpuName || pod.gpuId} × ${formatInteger(pod.gpuCount)}`
                  td= pod.usage.trackingAvailable ? formatDuration(pod.usage.runningMs) : 'Not recorded'
                  td= pod.usage.trackingAvailable ? formatDuration(pod.usage.stoppedMs) : 'Not recorded'
                  td.runpod-number= pod.billing.available ? formatUsd(pod.billing.totalUsd) : 'Pending sync'
                  td.runpod-number= pod.usage.trackingAvailable ? formatUsd(pod.usage.estimatedTotalUsd) : '—'
                  td
                    if pod.usageTrackingMode === 'billing_only'
                      span Billing through #{formatTimestamp(pod.archivedAt)}
                    else
                      span= formatTimestamp(pod.archivedAt)
      else
        .runpod-empty
          strong No archived Pods
          p Permanently deleted Pods will be retained here for lifecycle history.

    section.runpod-summary(aria-label='Runpod overview')
      article.runpod-stat
        span.runpod-stat__label GPU systems
        strong.runpod-stat__value= formatInteger(summary.gpuCount)
        span.runpod-stat__hint #{formatInteger(summary.availableGpuCount)} on Secure Cloud for Pods
      article.runpod-stat
        span.runpod-stat__label CPU systems
        strong.runpod-stat__value= formatInteger(summary.cpuCount)
        span.runpod-stat__hint Pod availability included
      article.runpod-stat
        span.runpod-stat__label Data centers
        strong.runpod-stat__value= formatInteger(summary.dataCenterCount)
        span.runpod-stat__hint Across #{formatInteger(summary.regionCount)} regions
      article.runpod-stat
        span.runpod-stat__label Official templates
        strong.runpod-stat__value= formatInteger(summary.templateCount)
        span.runpod-stat__hint Runpod-curated systems
      article.runpod-stat.runpod-stat--accent
        span.runpod-stat__label Selected-period spend
        strong.runpod-stat__value= formatUsd(summary.billingTotal, 2)
        span.runpod-stat__hint #{formatInteger(billing.recordCount)} billing buckets

    nav.runpod-section-nav(aria-label='Runpod dashboard sections')
      a(href='#workload-templates') Workload template
      a(href='#pod-creator') Create Pod
      a(href='#pods') Pods
      a(href='#archived-pods') Archive
      a(href='#billing-history') Stored billing
      a(href='#billing') Billing
      a(href='#gpus') GPUs
      a(href='#cpus') CPUs
      a(href='#datacenters') Data centers
      a(href='#templates') Templates

    section#billing-history.runpod-panel(aria-labelledby='runpodStoredBillingHeading')
      .runpod-panel__header
        div
          p.runpod-eyebrow Durable account ledger
          h2#runpodStoredBillingHeading Stored monthly billing
          p.runpod-panel__subtitle Monthly Runpod v2 charges are retained locally from November 2025 onward. Months omitted by Runpod are stored explicitly as zero; the current month remains provisional until it closes.
        form(method='post', action=`${adminPath}/billing/sync`)
          input(type='hidden', name='_csrf', value=csrfToken)
          button.runpod-button.runpod-button--secondary(type='submit') Sync billing history

      if billingHistory.error
        .runpod-alert.runpod-alert--warning(role='alert') Stored billing could not be loaded. The live billing explorer below may still be available.
      else if billingHistory.records.length
        .runpod-billing-total
          div
            span Stored total since November 2025
            strong= formatUsd(billingHistory.totals.total, 4)
          p #{formatInteger(billingHistory.providerMonthCount)} provider months · #{formatInteger(billingHistory.zeroMonthCount)} explicit zero/provisional months · synced #{formatTimestamp(billingHistory.lastSyncedAt)}
        .runpod-cost-grid
          article.runpod-cost
            span Pods
            strong= formatUsd(billingHistory.totals.pods)
          article.runpod-cost
            span Serverless
            strong= formatUsd(billingHistory.totals.serverless)
          article.runpod-cost
            span Network storage
            strong= formatUsd(billingHistory.totals.storage)
          article.runpod-cost
            span Public endpoints
            strong= formatUsd(billingHistory.totals.endpoints)
          article.runpod-cost
            span Clusters
            strong= formatUsd(billingHistory.totals.clusters)
        .runpod-table-wrap
          table.runpod-table
            caption Persisted monthly account billing, newest first
            thead
              tr
                th(scope='col') Month
                th(scope='col') Record source
                th.runpod-number(scope='col') Total
                th.runpod-number(scope='col') Pods
                th.runpod-number(scope='col') Serverless
                th.runpod-number(scope='col') Storage
            tbody
              each record in billingHistory.records
                tr
                  td= record.periodKey
                  td
                    if record.source === 'provider'
                      span.runpod-status.runpod-status--ready Runpod v2
                    else if record.source === 'synthesized_zero'
                      span.runpod-status.runpod-status--exited Stored zero
                    else
                      span.runpod-status.runpod-status--warning Provisional zero
                  td.runpod-number= formatUsd(record.total)
                  td.runpod-number= formatUsd(record.pods)
                  td.runpod-number= formatUsd(record.serverless)
                  td.runpod-number= formatUsd(record.storage)
      else
        .runpod-empty
          strong No stored billing months yet
          p Run “Sync billing history” to backfill November 2025 through the current month.

    section#billing.runpod-panel(aria-labelledby='runpodBillingHeading')
      .runpod-panel__header
        div
          p.runpod-eyebrow Account monitoring
          h2#runpodBillingHeading Live billing explorer
          p.runpod-panel__subtitle Inspect arbitrary recent buckets directly from the Runpod v2 billing endpoint. The durable monthly ledger above is the retained account history.
        if fetchedAt
          span.runpod-panel__meta Updated #{formatTimestamp(fetchedAt)}

      form.runpod-filter(method='get', action=adminPath)
        label.runpod-field(for='runpodBucketSize')
          span Bucket size
          select#runpodBucketSize(name='bucketSize')
            each option in billingBucketSizes
              option(value=option, selected=filters.bucketSize === option)= option
        label.runpod-field(for='runpodLastN')
          span Number of buckets
          input#runpodLastN(type='number', name='lastN', min='1', max=maxBillingBuckets, step='1', value=filters.lastN, required)
        button.runpod-button.runpod-button--primary(type='submit') Update period
        p.runpod-filter__help Up to #{maxBillingBuckets} buckets. Runpod aligns the requested period to bucket boundaries.

      .runpod-billing-total
        div
          span Total spend
          strong= formatUsd(billing.totals.total, 4)
        if billing.query.startTime && billing.query.endTime
          p #{formatTimestamp(billing.query.startTime)} to #{formatTimestamp(billing.query.endTime)}

      .runpod-cost-grid
        article.runpod-cost
          span Pods
          strong= formatUsd(billing.totals.pods)
        article.runpod-cost
          span Serverless
          strong= formatUsd(billing.totals.serverless)
        article.runpod-cost
          span Network storage
          strong= formatUsd(billing.totals.storage)
        article.runpod-cost
          span Public endpoints
          strong= formatUsd(billing.totals.endpoints)
        article.runpod-cost
          span Clusters
          strong= formatUsd(billing.totals.clusters)

      if billing.records.length
        .runpod-table-wrap
          table.runpod-table
            caption Billing buckets, newest first
            thead
              tr
                th(scope='col') Period start
                th.runpod-number(scope='col') Total
                th.runpod-number(scope='col') Pods
                th.runpod-number(scope='col') Serverless
                th.runpod-number(scope='col') Storage
                th.runpod-number(scope='col') Endpoints
                th.runpod-number(scope='col') Clusters
            tbody
              each record in billing.records
                tr
                  td= formatTimestamp(record.startTime)
                  td.runpod-number= formatUsd(record.total)
                  td.runpod-number= formatUsd(record.pods)
                  td.runpod-number= formatUsd(record.serverless)
                  td.runpod-number= formatUsd(record.storage)
                  td.runpod-number= formatUsd(record.endpoints)
                  td.runpod-number= formatUsd(record.clusters)
      else
        .runpod-empty
          strong No billed usage in this period
          p Runpod returned no billing records for the selected window.

    section#gpus.runpod-panel(aria-labelledby='runpodGpuHeading')
      .runpod-panel__header
        div
          p.runpod-eyebrow Pod hardware catalog
          h2#runpodGpuHeading GPU systems
          p.runpod-panel__subtitle Current Secure Cloud Pod availability and hourly list prices. Availability is a point-in-time signal and can change quickly.
        span.runpod-panel__meta #{formatInteger(gpus.length)} systems
      if gpus.length
        .runpod-table-wrap
          table.runpod-table
            caption Runpod GPU catalog for Pod workloads
            thead
              tr
                th(scope='col') GPU
                th(scope='col') VRAM
                th(scope='col') Availability
                th(scope='col') Secure Cloud
                th(scope='col') Community Cloud
                th(scope='col') CUDA / locations
            tbody
              each gpu in gpus
                tr
                  td.runpod-system
                    strong= gpu.name
                    code= gpu.id
                    span= `${gpu.manufacturer}${gpu.pool ? ` · ${gpu.pool}` : ''}`
                  td= Number.isFinite(gpu.memoryGb) ? `${formatInteger(gpu.memoryGb)} GB` : '—'
                  td
                    span.runpod-status(class=`runpod-status--${gpu.availability.toLowerCase()}`)= gpu.availability
                  td
                    if gpu.secure
                      strong= `${formatUsd(gpu.securePrice)} / hr`
                      span= `Up to ${formatInteger(gpu.maxSecureCount)} GPU${gpu.maxSecureCount === 1 ? '' : 's'}`
                    else
                      span.runpod-muted Not offered
                  td
                    if gpu.community
                      strong= `${formatUsd(gpu.communityPrice)} / hr`
                      span= `Up to ${formatInteger(gpu.maxCommunityCount)} GPU${gpu.maxCommunityCount === 1 ? '' : 's'}`
                    else
                      span.runpod-muted Not offered
                  td
                    if gpu.cudaVersions.length
                      span= gpu.cudaVersions.map((entry) => `${entry.version}${entry.available ? '' : ' (full)'}`).join(', ')
                    else
                      span.runpod-muted No CUDA listing
                    span= `${formatInteger(gpu.dataCenterCount)} matching data center${gpu.dataCenterCount === 1 ? '' : 's'}`
      else
        .runpod-empty
          strong GPU catalog unavailable
          p No GPU systems were returned.

    section#cpus.runpod-panel(aria-labelledby='runpodCpuHeading')
      .runpod-panel__header
        div
          p.runpod-eyebrow Pod hardware catalog
          h2#runpodCpuHeading CPU systems
          p.runpod-panel__subtitle CPU families, scaling range, memory ratio, availability, and per-vCPU pricing.
        span.runpod-panel__meta #{formatInteger(cpus.length)} systems
      if cpus.length
        .runpod-table-wrap
          table.runpod-table
            caption Runpod CPU catalog for Pod workloads
            thead
              tr
                th(scope='col') CPU family
                th(scope='col') Availability
                th(scope='col') vCPU range
                th(scope='col') RAM / vCPU
                th(scope='col') Secure price
                th(scope='col') Locations
            tbody
              each cpu in cpus
                tr
                  td.runpod-system
                    strong= cpu.name
                    code= cpu.id
                    span= cpu.group || 'No group'
                  td
                    span.runpod-status(class=`runpod-status--${cpu.availability.toLowerCase()}`)= cpu.availability
                  td= `${formatInteger(cpu.minimumVcpu)}–${formatInteger(cpu.maximumVcpu)}`
                  td= Number.isFinite(cpu.ramGbPerVcpu) ? `${formatInteger(cpu.ramGbPerVcpu)} GB` : '—'
                  td= Number.isFinite(cpu.securePricePerVcpu) ? `${formatUsd(cpu.securePricePerVcpu)} / vCPU hr` : '—'
                  td= `${formatInteger(cpu.dataCenterCount)} data center${cpu.dataCenterCount === 1 ? '' : 's'}`
      else
        .runpod-empty
          strong CPU catalog unavailable
          p No CPU systems were returned.

    section#datacenters.runpod-panel(aria-labelledby='runpodDataCenterHeading')
      .runpod-panel__header
        div
          p.runpod-eyebrow Regional catalog
          h2#runpodDataCenterHeading Data centers
          p.runpod-panel__subtitle Regions, storage options, compliance markers, and global-network support.
        span.runpod-panel__meta #{formatInteger(dataCenters.length)} locations
      if dataCenters.length
        .runpod-table-wrap
          table.runpod-table
            caption Runpod data center catalog
            thead
              tr
                th(scope='col') Data center
                th(scope='col') Region
                th(scope='col') Network volumes
                th(scope='col') Global network
                th(scope='col') Compliance
            tbody
              each dataCenter in dataCenters
                tr
                  td.runpod-system
                    strong= dataCenter.name
                    code= dataCenter.id
                  td= dataCenter.region.replaceAll('_', ' ')
                  td= dataCenter.networkVolumeTypes.length ? dataCenter.networkVolumeTypes.join(', ').replaceAll('_', ' ') : '—'
                  td= dataCenter.globalNetwork ? 'Supported' : 'No'
                  td= dataCenter.compliance.length ? dataCenter.compliance.join(', ').replaceAll('_', ' ') : '—'
      else
        .runpod-empty
          strong Data center catalog unavailable
          p No data centers were returned.

    section#templates.runpod-panel(aria-labelledby='runpodTemplateHeading')
      .runpod-panel__header
        div
          p.runpod-eyebrow Curated system images
          h2#runpodTemplateHeading Official templates
          p.runpod-panel__subtitle Read-only discovery of Runpod-maintained container templates. Private environment values are not displayed.
        span.runpod-panel__meta #{formatInteger(templates.length)} templates
      if templates.length
        .runpod-template-grid
          each template in templates
            article.runpod-template
              .runpod-template__header
                div
                  h3= template.name
                  code= template.id
                span.runpod-chip= template.category
              dl
                div
                  dt Image
                  dd= template.image || '—'
                div
                  dt Container disk
                  dd= Number.isFinite(template.diskGb) ? `${formatInteger(template.diskGb)} GB` : '—'
                div
                  dt Persistent mount
                  dd
                    if Number.isFinite(template.persistentDiskGb)
                      | #{formatInteger(template.persistentDiskGb)} GB at #{template.persistentPath || 'unspecified path'}
                    else
                      | —
                div
                  dt CUDA
                  dd= template.cudaVersions.length ? template.cudaVersions.join(', ') : '—'
                div
                  dt Ports
                  dd= template.ports.length ? template.ports.join(', ') : '—'
                div
                  dt Services
                  dd= [template.startJupyter ? 'Jupyter' : null, template.startSsh ? 'SSH' : null, template.serverless ? 'Serverless' : null].filter(Boolean).join(', ') || 'None declared'
      else
        .runpod-empty
          strong Template catalog unavailable
          p No official templates were returned.

    footer.runpod-footer
      p
        | Source: Runpod REST API v2. The API is currently in public beta, so response fields may evolve.
      .runpod-footer__links
        a(href='https://docs.runpod.io/api-reference-v2/overview', target='_blank', rel='noopener noreferrer') API v2 reference
        a(href='https://www.runpod.io/blog/runpods-rest-api-v2-is-here-one-api-for-your-entire-gpu-stack', target='_blank', rel='noopener noreferrer') Announcement
