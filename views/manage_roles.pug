extends layout

block content
  h1 Manage roles
  label.form-label(for='selection') Select role to modify
  select#selection.form-select(form='role-editor' name='role' required)
    option(value='') Choose a user or group
    optgroup(label='Groups')
      each g in selection.role_list
        option(value=g data-type='group')= `${g} (group)`
    optgroup(label='Users')
      each n in selection.name_list
        option(value=n data-type='user')= `${n} (user)`
  label.form-label.mt-3(for='permission-filter') Find permissions
  input#permission-filter.form-control(type='search' placeholder='Search by feature or permission')
  p#no-matches.mt-3(role='status' hidden) No permissions match your search.
  form#role-editor(action='/admin/update_role' method='post')
    input(type='hidden' name='_csrf' value=csrfToken)
    input#type(type='hidden' name='type')
    each group, g in selection.groups
      fieldset.permission-group.my-3
        legend.h5= group.name
        .row.g-2
          each p, i in group.permissions
            .permission-option.col-12.col-md-6.col-xl-4
              .form-check
                input.form-check-input(type='checkbox' id=`permission-${g}-${i}` name='route_permissions' value=p)
                label.form-check-label.text-break(for=`permission-${g}-${i}`)= p
    button#update-role.btn.btn-primary(type='submit' disabled) Update
  details.my-4
    summary Current role assignments
    table.table.table-striped
      thead
        tr
          th Role (type)
          th Explicit permissions
      tbody
        each role in roles
          tr
            td= `${role.name} (${role.type})`
            td= role.permissions.join(', ')
  pre#roles(hidden)= JSON.stringify(roles)
  script(src='/js/manage_roles.js')
