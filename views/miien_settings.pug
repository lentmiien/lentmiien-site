extends miien_base
block content
  - const settings = conversation ? conversation.metadata : { contextPrompt: defaultContext, maxMessages: 20, reasoning: 'medium', verbosity: 'low' };
  .miien-start
    .intro-art
      img(src='/i/miien/neutral.webp', alt='Miien, an anime catgirl with dark twin tails, amber eyes and a graphite hoodie', width='768', height='1024')
      .art-caption
        span.eyebrow A familiar face. A new conversation.
        h1 A little company,<br> a little curiosity.
        p Meet Miien, your Chat5 companion.
    section.settings-panel(aria-labelledby='settings-heading')
      span.eyebrow Character chat · Phase 1
      h2#settings-heading= conversation ? 'Room settings' : 'Make yourself comfortable'
      p.subtle= conversation ? 'Changes apply to this saved Chat5 conversation.' : 'Choose a model, settle in, and talk. Your conversation stays in Chat5.'
      if !canWrite
        p.hint This account has read-only access. Conversation creation and settings changes require write access.
      form#settings-form(method='post', action=conversation ? `/chat5/miien/${conversation._id}/settings` : '/chat5/miien')
        input(type='hidden', name='_csrf', value=csrfToken)
        label(for='title') Conversation name
        input#title(name='title', required, maxlength='100', value=conversation ? conversation.title : 'A conversation with Miien')
        label(for='model') Chat model
        select#model(name='model', required)
          if !models.length
            option(value='') No supported Chat5 models configured
          if conversation && !models.some(m => m.id === settings.model)
            option(value='', selected) Saved model unavailable — choose another
          each model in models
            option(value=model.id, selected=model.id === settings.model)= `${model.name} · ${model.provider}`
        p.hint Models come from the Chat5 catalog. Response speed and cost depend on your choice.
        .settings-row
          div
            label(for='reasoning') Reasoning effort
            select#reasoning(name='reasoning')
              each value in ['low', 'medium', 'high']
                option(value=value, selected=value === settings.reasoning)= value
          div
            label(for='verbosity') Response detail
            select#verbosity(name='verbosity')
              each value in ['low', 'medium', 'high']
                option(value=value, selected=value === settings.verbosity)= value
        label(for='maxMessages') Recent messages in context (2–40)
        input#maxMessages(type='number', name='maxMessages', min='2', max='40', required, value=settings.maxMessages)
        details
          summary Character & conversation instructions
          label(for='context') Saved context prompt
          textarea#context(name='context', maxlength='4000', rows='6')= settings.contextPrompt
          p.hint Only this conversation uses these instructions. They are editable and saved in Chat5.
        fieldset
          legend Voice preferences · this browser tab
          label.check
            input#speech-enabled(type='checkbox')
            | Speak new replies (browser voice placeholder)
          label(for='speech-voice') Playback voice
          select#speech-voice
            option(value='') Browser default
          p#speech-status.hint(role='status') Device voices vary. Some browser/OS voices send text to their speech provider.
          if canTranscribe
            p.hint Microphone input uses the configured ASR service. Up to 60 seconds; edit the transcript before sending. Audio is not saved by this interface.
          else
            p.hint Microphone transcription is unavailable for this account. Text input is always available.
        button.primary(type='submit', disabled=!models.length || !canWrite)= conversation ? 'Save & return to Miien' : 'Start talking with Miien →'
        if conversation
          a.secondary(href=`/chat5/miien/${conversation._id}`) Cancel
      if !conversation
        details.resume
          summary Resume a Chat5 conversation
          p.hint Recent single-member rooms with text output, no tools and a 2–40 message context window. Media conversations cannot be resumed here.
          if !conversations.length
            p No compatible candidates yet. Start a new room above.
          each item in conversations
            a.resume-link(href=`/chat5/miien/${item._id}`)= item.title
block scripts
  script(src='/js/miien_voice.js', defer)
