extends layout

block styles
  link(rel='stylesheet', href='/css/account_dashboard.css')
  link(rel='stylesheet', href='/css/mypage_tasks.css')
  link(rel='stylesheet', href='/css/account_life_log.css')

block content
  - const settings = typeof dashboard !== 'undefined' ? dashboard : { sections: [], hiddenSections: [], collapsedSections: [], jobs: {} };
  main#account-dashboard.account-dashboard(data-csrf-token=csrfToken, data-life-log-script=formAssetUrl('my_life_log.js'))
    header.account-heading
      div
        p.account-eyebrow= typeof accountContext !== 'undefined' ? accountContext : 'Your account'
        h1 Welcome back
        p.account-date
          span= typeof accountDate !== 'undefined' ? accountDate : ''
          |  · Asia/Tokyo
      button#account-customize.account-primary(type='button', aria-haspopup='dialog', aria-controls='account-customizer') Customize account
    p.account-intro A little space for your day. Open Tools above to find everything else.
    #account-status(role='status', aria-live='polite')
    .account-grid
      each section in settings.sections
        section.account-card(data-section=section.id, hidden=settings.hiddenSections.includes(section.id), class=section.id === 'life' ? 'account-card-wide' : '')
          header.account-card-heading
            div
              p.account-eyebrow= section.scope
              h2
                button.account-collapse(type='button', aria-expanded=!settings.collapsedSections.includes(section.id), aria-controls=`card-${section.id}`)= section.title
            button.account-refresh(type='button', aria-label=`Refresh ${section.title}`) ↻
          .account-card-content(id=`card-${section.id}`, hidden=settings.collapsedSections.includes(section.id))
            .account-card-state(role='status') Loading…
            .account-card-data
            if section.id === 'tasks'
              #mypage-tasks(data-csrf-token=csrfToken)
                p#mypage-task-hint.account-note Hold a task for 0.9 seconds to complete. Keyboard: focus a task and press Space to complete; Enter opens all tasks.
                .account-task-list
                a.schedule-task-pill--empty(href='/scheduleTask/upcoming') Show all tasks
                p#mypage-task-status(role='status', aria-live='polite')
            if section.id === 'embedding'
              form.account-search-form(method='post', action='/mypage/embedding-search')
                input(type='hidden', name='_csrf', value=csrfToken)
                label(for='account-search-query') Search text
                input#account-search-query(type='search', name='search_text', maxlength='2000', required, placeholder='Search your saved knowledge…')
                label(for='account-search-type') Search mode
                select#account-search-type(name='search_type')
                  option(value='default') Fast
                  option(value='high_quality') High quality
                  option(value='combined') Combined
                button.account-primary(type='submit') Search
            if section.id === 'jobs'
              button.account-filter-open(type='button') Edit activity filters
            p.account-card-note.account-note
            if section.href !== '/mypage'
              a.account-card-link(href=section.href) Open #{section.title} →
    if !settings.sections.length
      p No dashboard sections are currently available for this account.
    noscript
      p Enable JavaScript to load account summaries. Tools navigation and the section links remain available.
    dialog#account-customizer(aria-labelledby='customize-title')
      .account-dialog-heading
        h2#customize-title Make this space yours
        button#account-customize-close(type='button') Close
      p Choose sections, their starting state and their order. Hidden sections do not load.
      ol#section-preferences
        each section in settings.sections
          li(data-setting-id=section.id)
            label
              input(type='checkbox', data-visible, checked=!settings.hiddenSections.includes(section.id))
              |  #{section.title}
            label.account-note
              input(type='checkbox', data-collapsed, checked=settings.collapsedSections.includes(section.id))
              |  Start collapsed
            .account-order-buttons
              button(type='button', data-move='up', aria-label=`Move ${section.title} up`) ↑
              button(type='button', data-move='down', aria-label=`Move ${section.title} down`) ↓
      fieldset.account-job-settings
        legend Recent activity filters
        label(for='job-scope') Scope
        select#job-scope
          option(value='mine', selected=settings.jobs.scope === 'mine') Mine
          option(value='shared', selected=settings.jobs.scope === 'shared') Shared libraries / operations
        label(for='job-status') Status
        select#job-status
          each status in ['all', 'queued', 'running', 'completed', 'failed', 'cancelled']
            option(value=status, selected=settings.jobs.status === status)= status
        label(for='job-window') Created within
        select#job-window
          each days in [7, 30, 90]
            option(value=days, selected=settings.jobs.dateWindow === days) #{days} days
        p.account-note Sources without ownership appear only under Shared. Saved-history sources cannot report running jobs.
        #job-types
      p#account-save-status(role='status', aria-live='polite')
      .account-dialog-actions
        button#account-save.account-primary(type='button') Save dashboard
        button#account-reset(type='button') Reset dashboard
      details#customize-shortcuts
        summary Navbar shortcuts
        p Hidden shortcuts remain discoverable in the full Tools catalog. The first eight visible tools become shortcuts.
        ol#nav-preferences
          each item in (typeof navChoices !== 'undefined' ? navChoices : []).filter(n => !n.public)
            li(data-nav-id=item.id)
              label
                input(type='checkbox', checked=!item.hidden)
                |  #{item.label}
              .account-order-buttons
                button(type='button', data-move='up', aria-label=`Move ${item.label} up`) ↑
                button(type='button', data-move='down', aria-label=`Move ${item.label} down`) ↓
        button#nav-save.account-primary(type='button') Save shortcuts
        button#nav-reset(type='button') Reset shortcuts
        p#nav-save-status(role='status', aria-live='polite')
  script#account-settings(type='application/json')!= safeJson(settings)

block script
  script(src=formAssetUrl('mypage_tasks.js'), defer)
  script(src=formAssetUrl('account_dashboard.js'), defer)
