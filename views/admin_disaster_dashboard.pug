extends layout

block styles
  link(rel='stylesheet', href='/css/disaster_local.css?v=3')

block content
  main.local-watch
    header.local-watch__header
      div
        p.local-eyebrow ASAHI-KU · YOKOHAMA
        h1 Your neighbourhood, now.
        p.local-muted Weather and authoritative local conditions · Asia/Tokyo
      a.local-link(href='/mypage') My account
    if loadError
      p.local-notice(role='alert')= loadError
    if feedback
      p.local-notice(role='status')= feedback.message
    - const weather = summary.weather;
    section.local-weather(aria-labelledby='weather-heading')
      img.local-weather__art(src=weather.art alt='' width='720' height='480')
      .local-weather__copy
        p.local-eyebrow= weather.label
        h2#weather-heading= summary.location
        p.local-temperature= Number.isFinite(weather.temperatureC) ? `${weather.temperatureC.toFixed(1)}°` : '—'
        p.local-condition= weather.description || 'Waiting for a current observation'
        if Number.isFinite(weather.feelsLikeC)
          p.local-muted Feels like #{weather.feelsLikeC.toFixed(1)}°C
        dl.local-metrics
          if Number.isFinite(weather.humidityPercent)
            div
              dt Humidity
              dd #{weather.humidityPercent}%
          if Number.isFinite(weather.windSpeedMs)
            div
              dt Wind
              dd #{weather.windSpeedMs.toFixed(1)} m/s
          if Number.isFinite(weather.precipitationMm)
            div
              dt Rain / snow · #{weather.precipitationPeriodHours || 1}h
              dd #{weather.precipitationMm.toFixed(1)} mm
        p.local-muted
          | #{weather.estimated ? 'Forecast valid' : 'Observed'}: #{formatDateTimeLong(weather.observedAt)} JST
          br
          | #{weather.source || 'Source unavailable'} · #{weather.freshness}
    section.local-panel(aria-labelledby='warnings-heading')
      p.local-eyebrow YOKOHAMA NORTH · INCLUDES ASAHI-KU
      h2#warnings-heading= summary.warnings.label
      if summary.warnings.active.length
        ul.local-hazards
          each hazard in summary.warnings.active
            li
              strong= hazard.name
              span #{hazard.severity} · #{hazard.status}
      p.local-muted= summary.warnings.note
      p.local-muted Local bulletin: #{formatDateTimeLong(summary.warnings.at)} JST
      if summary.warnings.history.length
        details
          summary Last-known local hazards · status unconfirmed
          ul
            each hazard in summary.warnings.history
              li= hazard.name
      a.local-link(href='https://www.jma.go.jp/bosai/warning/#area_type=class20s&area_code=1410011&lang=ja' target='_blank' rel='noopener noreferrer') Check JMA local warnings ↗
    .local-hazard-grid
      section.local-panel.local-hazard(aria-labelledby='quake-heading')
        img(src=summary.earthquake.art alt='' width='720' height='480' loading='lazy')
        .local-hazard__copy
          p.local-eyebrow LATEST EARTHQUAKE REPORT · LOCAL SHAKING
          h2#quake-heading= summary.earthquake.label
          p= summary.earthquake.description
          p.local-muted= summary.earthquake.historical ? 'Historical or unavailable report; not current shaking.' : 'Reported observation; not a prediction.'
          p.local-muted #{formatDateTimeLong(summary.earthquake.at)} JST
          if summary.earthquake.nationalMax !== null && summary.earthquake.nationalMax !== undefined
            p.local-muted National maximum intensity: #{summary.earthquake.nationalMax}
          if Number.isFinite(summary.earthquake.magnitude)
            p.local-muted Epicentral magnitude: M#{summary.earthquake.magnitude}
          p.local-muted Illustration explains this intensity class; it does not document local damage.
      section.local-panel.local-hazard(aria-labelledby='typhoon-heading')
        img(src=summary.typhoon.art alt='' width='720' height='480' loading='lazy')
        .local-hazard__copy
          p.local-eyebrow TYPHOON · LOCAL RELEVANCE
          h2#typhoon-heading= summary.typhoon.label
          if summary.typhoon.state === 'probability'
            p #{summary.typhoon.probability}% local storm-wind probability in the reported forecast window.
          if summary.typhoon.state === 'proximity'
            p A reported or next-24-hour forecast storm centre is within 900 km of the local weather point.
          p.local-muted= summary.typhoon.note
          p.local-muted #{formatDateTimeLong(summary.typhoon.at)} JST
    section.local-panel(aria-labelledby='sources-heading')
      h2#sources-heading Sources & archive
      p.local-muted Source check: #{formatDateTimeLong(summary.sourceCheckedAt)} JST. Weather is polled independently every 15 minutes. Reloading stored data does not contact providers.
      .local-actions
        a.local-button.local-button--secondary(href='/admin/disasters') Reload stored data
        form#disaster-refresh(method='post' action='/admin/disasters/refresh')
          input(type='hidden' name='_csrf' value=csrfToken)
          button.local-button(type='submit') Refresh sources
        a.local-link(href='/admin/disasters/history') Bulletin archive
        a.local-link(href='/admin/disasters/weather-history') Weather history
      p#disaster-refresh-status.local-muted(role='status' aria-live='polite')
      p.local-muted This page is a local overview, not an emergency notification service. Follow JMA and municipal instructions.

block script
  script(src='/js/disaster_local.js?v=3' defer)
