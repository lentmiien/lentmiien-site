extends ../layout

block styles
  link(rel='stylesheet', href='/css/codex.css')

block content
  - const state = codexState || {};
  - const turn = state.turn || {};
  - const session = state.session || {};
  - const workspace = state.workspace || {};
  - const config = state.config || {};
  - const maxPromptChars = Number(config.maxPromptChars) > 0 ? Number(config.maxPromptChars) : 20000;
  - const tokenTypes = ['input', 'cached', 'output', 'reasoning'];
  - const tokenLabels = { input: 'Input', cached: 'Cached', output: 'Output', reasoning: 'Reasoning' };
  - const fmt = (value) => value ? new Date(value).toLocaleString() : '-';
  - const num = (value) => Number.isFinite(Number(value)) ? Math.round(Number(value)).toLocaleString() : '0';
  - const money = (value) => '$' + (Number(value) || 0).toFixed(4);
  - const duration = (ms) => Number.isFinite(ms) ? `${Math.round(ms / 1000)}s` : '-';
  - const statusClass = (status) => `codex-status codex-status--${String(status || '').replace(/_/g, '-')}`;
  section.codex-page(data-codex-page='turn', data-turn-id=turn.id)
    .codex-shell
      .codex-topbar
        div
          a.codex-back-link(href=`/codex/sessions/${session.id}`) Back to session
          h1.codex-title= `Turn ${turn.sequence || ''}`
          p.codex-subtitle
            span= session.title || 'Codex session'
            span= ' / '
            span= workspace.name || 'Workspace'
        .codex-topbar__actions(data-turn-actions)
          if turn.status === 'queued' || turn.status === 'running'
            button.codex-button.codex-button--secondary(type='button', data-action='cancel-turn', data-turn-id=turn.id) Cancel
          if ['failed', 'timed_out', 'cancelled', 'blocked'].includes(turn.status)
            button.codex-button.codex-button--secondary(type='button', data-action='retry-turn', data-turn-id=turn.id) Retry

      .codex-turn-detail(data-codex-turn-detail)
        .codex-panel
          .codex-panel__header
            h2 Status
            span(class=statusClass(turn.status))= turn.status
          .codex-live-activity-slot(data-live-activity-slot)
            if turn.status === 'running'
              .codex-live-activity(data-turn-activity=turn.id, data-activity-state='live', aria-label='Live Codex process activity')
                span.codex-live-activity__signal(aria-hidden='true')
                  span
                  span
                  span
                span.codex-live-activity__copy
                  strong(data-activity-heading) Codex is working
                  span(data-activity-summary) Waiting for the first process detail…
                span.codex-visually-hidden(data-activity-announcement, aria-live='polite', aria-atomic='true')
          .codex-detail-grid
            div
              small Workspace
              strong= workspace.name || '-'
            div
              small Mode
              strong= turn.kind ? turn.kind.replace(/_/g, ' ') : '-'
            div
              small Permission
              strong= turn.permissionMode || '-'
            div
              small Profile
              strong= turn.requestProfileName || turn.profile || '-'
            div
              small Provider
              strong= turn.modelProviderLabel || (turn.modelProvider === 'ollama' ? 'Ollama' : 'OpenAI')
            div
              small Model
              strong= turn.model || '-'
            div
              small Reasoning
              strong= turn.reasoningEffort || '-'
            div
              small Queued
              strong= fmt(turn.queuedAt)
            div
              small Started
              strong= fmt(turn.startedAt)
            div
              small Completed
              strong= fmt(turn.completedAt)
            div
              small Duration
              strong= duration(turn.durationMs)
            div
              small Turn Input Tokens
              strong= num(turn.tokenUsage && turn.tokenUsage.input)
            div
              small Turn Cached Tokens
              strong= num(turn.tokenUsage && turn.tokenUsage.cached)
            div
              small Turn Output Tokens
              strong= num(turn.tokenUsage && turn.tokenUsage.output)
            div
              small Turn Reasoning Tokens
              strong= num(turn.tokenUsage && turn.tokenUsage.reasoning)
            div
              small= turn.usageProvider === 'ollama' ? 'Turn Ollama Estimated Cost' : 'Turn OpenAI Estimated Cost'
              strong= money(turn.costEstimate && turn.costEstimate.total)
            div
              small Exit
              strong= turn.exitCode === null || turn.exitCode === undefined ? '-' : turn.exitCode
          p.codex-error-text(data-turn-error, hidden=!turn.errorMessage)= turn.errorMessage || ''

        if (turn.status === 'queued' || turn.status === 'running') && turn.canAddMessage
          section.codex-panel.codex-additional-message-panel(
            data-additional-message-panel,
            hidden=turn.status !== 'running'
          )
            .codex-panel__header
              h2 Add a message
              span.codex-chip(data-additional-message-state)= turn.status === 'running' ? 'Running' : 'Waiting'
            p.codex-field-help Send a course correction or missing detail to the Codex turn that is currently running.
            form#codex-additional-message-form.codex-form(data-turn-id=turn.id, data-codex-prompt-form)
              .codex-field
                .codex-field-label-row
                  label(for='codex-additional-message') Message
                textarea#codex-additional-message(
                  name='message',
                  rows='3',
                  maxlength=maxPromptChars,
                  required,
                  data-codex-prompt-input,
                  data-max-characters=maxPromptChars,
                  aria-describedby='codex-additional-message-help codex-additional-message-character-count'
                )
                small#codex-additional-message-help.codex-field-help After Codex accepts it, the message is added to Process Details and appended to this active turn.
                small#codex-additional-message-character-count.codex-character-count(data-codex-character-count)= `0 / ${maxPromptChars.toLocaleString()} characters`
              .codex-actions
                button.codex-button(type='submit', data-codex-prompt-submit) Send message
                span#codex-additional-message-status.codex-form-status(aria-live='polite')

        .codex-transcript.codex-transcript--detail
          .codex-transcript__block
            h2 Prompt
            pre= turn.prompt
          .codex-transcript__block
            h2 Response
            if turn.finalResponse
              pre= turn.finalResponse
            else
              p.codex-empty Response pending.

        section.codex-panel.codex-process-activity(data-process-activity, data-turn-started-at=turn.startedAt || turn.queuedAt || '')
          .codex-panel__header.codex-process-activity__header
            div
              h2 Process Details
              p.codex-process-activity__summary
                span(data-process-live-cluster, hidden=turn.status !== 'running')
                  span.codex-process-live-label(data-process-live-label) LIVE
                  span(aria-hidden='true') ·
                span(data-process-duration)= duration(turn.durationMs)
                span(aria-hidden='true') ·
                span(data-process-count-summary) Loading activity…
            .codex-process-details__actions
              button.codex-small-button(
                type='button',
                data-action='toggle-event-order',
                data-turn-id=turn.id,
                aria-label='Change activity order'
              ) Newest first
              button.codex-small-button(
                type='button',
                data-action='toggle-live-pause',
                data-turn-id=turn.id,
                hidden=turn.status !== 'running',
                aria-pressed='false'
              ) Pause live

          - const detailsId = `codex-events-${turn.id}`;
          - const issuesId = `codex-issues-${turn.id}`;
          - const rawId = `codex-raw-events-${turn.id}`;
          .codex-process-tabs(role='tablist', aria-label='Process detail view')
            button.codex-process-tab(
              type='button',
              role='tab',
              id=`codex-activity-tab-${turn.id}`,
              data-action='set-event-view',
              data-turn-id=turn.id,
              data-event-view-mode='activity',
              aria-controls=detailsId,
              aria-selected='true',
              tabindex='0'
            )
              | Activity
              span.codex-process-tab__count(data-activity-count) 0
            button.codex-process-tab(
              type='button',
              role='tab',
              id=`codex-issues-tab-${turn.id}`,
              data-action='set-event-view',
              data-turn-id=turn.id,
              data-event-view-mode='issues',
              aria-controls=issuesId,
              aria-selected='false',
              tabindex='-1'
            )
              | Issues
              span.codex-process-tab__count(data-issue-count) 0
            button.codex-process-tab(
              type='button',
              role='tab',
              id=`codex-raw-tab-${turn.id}`,
              data-action='set-event-view',
              data-turn-id=turn.id,
              data-event-view-mode='raw',
              aria-controls=rawId,
              aria-selected='false',
              tabindex='-1'
            )
              | Raw events
              span.codex-process-tab__count(data-raw-count)= turn.eventCount || 0

          .codex-activity-ribbon(data-activity-ribbon, aria-label='Time-proportional turn activity')
            .codex-activity-ribbon__track
            .codex-activity-ribbon__legend
              span
                i.codex-activity-ribbon__swatch.codex-activity-ribbon__swatch--message(aria-hidden='true')
                | Messages
              span
                i.codex-activity-ribbon__swatch.codex-activity-ribbon__swatch--work(aria-hidden='true')
                | Work
              span
                i.codex-activity-ribbon__swatch.codex-activity-ribbon__swatch--issue(aria-hidden='true')
                | Issues

          .codex-process-layout
            .codex-process-main
              button.codex-new-updates-button(
                type='button',
                data-action='show-new-updates',
                data-turn-id=turn.id,
                hidden
              ) 0 new updates
              section.codex-process-panel(
                id=detailsId,
                role='tabpanel',
                aria-labelledby=`codex-activity-tab-${turn.id}`,
                data-process-panel='activity'
              )
                .codex-events(data-events-for=turn.id, data-event-view-mode='activity')
              section.codex-process-panel(
                id=issuesId,
                role='tabpanel',
                aria-labelledby=`codex-issues-tab-${turn.id}`,
                data-process-panel='issues',
                hidden
              )
                .codex-events.codex-events--issues(data-issues-for=turn.id)
              section.codex-process-panel(
                id=rawId,
                role='tabpanel',
                aria-labelledby=`codex-raw-tab-${turn.id}`,
                data-process-panel='raw',
                hidden
              )
                .codex-raw-toolbar
                  label
                    span Category
                    select(data-raw-filter='category')
                      option(value='') All
                      option(value='message') Messages
                      option(value='work') Work
                      option(value='collaboration') Collaboration
                      option(value='model') Model activity
                      option(value='plan') Plans
                      option(value='issue') Issues
                      option(value='lifecycle') Lifecycle
                      option(value='telemetry') Telemetry
                      option(value='system') System
                  label
                    span Stream
                    select(data-raw-filter='stream')
                      option(value='') All
                      option(value='stdout-json') JSON
                      option(value='stdout') Stdout
                      option(value='stderr') Stderr
                      option(value='system') System
                  label
                    span Severity
                    select(data-raw-filter='severity')
                      option(value='') All
                      option(value='info') Info
                      option(value='warning') Warning
                      option(value='error') Error
                  label
                    span Event type
                    input(type='search', data-raw-filter='eventType', maxlength='160', placeholder='item.completed')
                  label.codex-raw-toolbar__search
                    span Search loaded events
                    input(type='search', data-raw-filter='text', maxlength='200', placeholder='Text or payload')
                .codex-raw-events(data-raw-events-for=turn.id)
                  p.codex-empty Raw events load only when this tab is opened.
                button.codex-small-button(
                  type='button',
                  data-action='load-more-raw-events',
                  data-turn-id=turn.id,
                  hidden
                ) Load older events

            aside.codex-process-sidebar(aria-label='Turn work summary')
              details.codex-side-card(data-plan-sidebar, open)
                summary
                  span Plan
                  small(data-plan-progress) Not reported
                .codex-side-card__body(data-plan-content)
                  p.codex-empty No plan reported.
              details.codex-side-card(id=`codex-changed-files-${turn.id}`, data-files-sidebar, open)
                summary
                  span Changed files
                  small(data-files-count) 0
                .codex-side-card__body(data-files-content)
                  p.codex-empty No file changes reported.
              details.codex-side-card(data-agents-sidebar, hidden)
                summary
                  span Active agents
                  small(data-agents-count) 0
                .codex-side-card__body(data-agents-content)

block script
  script#codex-page-data(type='application/json')!= codexStateJson
  script(src='/js/codex.js', defer)
